<div class="page-head"><h1><%- icon('search', 24) %> جستجو: «<%= q %>»</h1></div>
<% if (q.length < 2) { %><div class="alert info">حداقل دو حرف وارد کنید.</div><% } else {
  var any = false; Object.keys(out).forEach(function(k){ if (out[k] && out[k].length) any = true; }); %>
<% if (!any) { %><div class="card empty">نتیجه‌ای یافت نشد.</div><% } %>
<% if (out.students && out.students.length) { %><div class="card flush"><div class="card-title"><%- icon('graduation-cap', 18) %> دانش‌آموزان</div><table class="t"><tbody><% out.students.forEach(function(s){ %><tr><td><a href="<%= u('/students/' + s.id) %>"><%= s.first_name %> <%= s.last_name %></a></td><td class="num"><%= fa(s.student_code) %></td><td><%= s.class_name || '—' %></td></tr><% }) %></tbody></table></div><% } %>
<% if (out.teachers && out.teachers.length) { %><div class="card flush"><div class="card-title"><%- icon('briefcase', 18) %> معلمان</div><table class="t"><tbody><% out.teachers.forEach(function(s){ %><tr><td><a href="<%= u('/teachers/' + s.id) %>"><%= s.full_name %></a></td><td><%= s.specialty || '' %></td></tr><% }) %></tbody></table></div><% } %>
<% if (out.tickets && out.tickets.length) { %><div class="card flush"><div class="card-title"><%- icon('life-buoy', 18) %> تیکت‌ها</div><table class="t"><tbody><% out.tickets.forEach(function(s){ %><tr><td><a href="<%= u('/tickets/' + s.id) %>"><%= s.subject %></a></td><td><%- pill(L.ticketStatus[s.status], badges_map.ticketStatus[s.status]) %></td></tr><% }) %></tbody></table></div><% } %>
<% if (out.announcements && out.announcements.length) { %><div class="card flush"><div class="card-title"><%- icon('megaphone', 18) %> اطلاعیه‌ها</div><table class="t"><tbody><% out.announcements.forEach(function(s){ %><tr><td><a href="<%= u('/announcements') %>"><%= s.title %></a></td><td class="muted small"><%= d(s.created_at) %></td></tr><% }) %></tbody></table></div><% } %>
<% if (out.books && out.books.length) { %><div class="card flush"><div class="card-title"><%- icon('library-big', 18) %> کتاب‌ها</div><table class="t"><tbody><% out.books.forEach(function(s){ %><tr><td><%= s.title %></td><td><%= s.author %></td><td><%= s.category %></td></tr><% }) %></tbody></table></div><% } %>
<% } %>
