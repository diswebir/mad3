<div class="page-head"><span class="avatar lg"><%= initials(t.full_name) %></span><div><div class="crumbs"><a href="<%= u('/teachers') %>">معلمان</a></div><h1><%= t.full_name %> <%- pill(L.teacherStatus[t.status] || t.status, t.status === 'active' ? 'green' : 'amber') %></h1><div class="muted"><%= t.specialty || '' %> <%= t.degree ? '— ' + t.degree : '' %></div></div>
<div class="actions"><% if (user.role === 'admin') { %><a class="btn" href="<%= u('/access/user/' + t.user_id) %>"><%- icon('key-round', 16) %> سطح دسترسی</a><% } %><a class="btn primary" href="<%= u('/teachers/' + t.id + '/edit') %>"><%- icon('pencil', 16) %> ویرایش</a></div></div>
<div class="grid g4" style="margin-bottom:1rem">
  <div class="card stat" style="margin:0"><div class="ico"><%- icon('school', 22) %></div><div><div class="v"><%= fa(homerooms.length) %></div><div class="l">کلاس راهنما</div></div></div>
  <div class="card stat green" style="margin:0"><div class="ico"><%- icon('book-open', 22) %></div><div><div class="v"><%= fa(assigned.length) %></div><div class="l">درس تخصیص‌یافته</div></div></div>
  <div class="card stat amber" style="margin:0"><div class="ico"><%- icon('clock', 22) %></div><div><div class="v"><%= fa(hours) %></div><div class="l">ساعت هفتگی</div></div></div>
  <div class="card stat" style="margin:0"><div class="ico"><%- icon('graduation-cap', 22) %></div><div><div class="v"><%= fa(students) %></div><div class="l">دانش‌آموز کلاس راهنما</div></div></div>
</div>
<div class="grid g2">
<div class="card"><h3><%- icon('user-round', 18) %> مشخصات</h3><dl class="kv"><dt>نام کاربری</dt><dd class="ltr"><%= t.username %></dd><dt>موبایل</dt><dd class="ltr"><%= fa(t.phone || '—') %></dd><dt>ایمیل</dt><dd class="ltr"><%= t.email || '—' %></dd>
<% tfields.forEach(function(f){ if (f.type === 'textarea' && !t[f.name]) return; var v = t[f.name]; if (f.type === 'date') v = d(v); else if (f.name === 'gender') v = L.genderAdult[v]; else if (f.name === 'status') v = L.teacherStatus[v]; %><dt><%= f.label %></dt><dd><%= v || '—' %></dd><% }) %><dt>آخرین ورود</dt><dd><%= t.last_login ? dt(t.last_login) : '—' %></dd></dl>
<div style="display:flex;gap:.5rem;margin-top:1rem;flex-wrap:wrap">
<form method="post" action="<%= u('/teachers/' + t.id + '/reset-password') %>" data-confirm="رمز عبور بازنشانی شود؟"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn"><%- icon('key-round', 16) %> بازنشانی رمز</button></form>
<form method="post" action="<%= u('/teachers/' + t.id + '/delete') %>" data-confirm="معلم حذف شود؟"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn danger"><%- icon('trash-2', 16) %> حذف</button></form></div></div>
<div><div class="card"><h3><%- icon('school', 18) %> کلاس‌های راهنما</h3><% if (!homerooms.length) { %><div class="muted">کلاس راهنمایی ندارد. از صفحه ویرایش کلاس می‌توانید تعیین کنید.</div><% } %><ul class="list"><% homerooms.forEach(function(h){ %><li><a href="<%= u('/classes/' + h.id) %>"><b><%= h.name %></b></a></li><% }) %></ul></div>
<div class="card flush"><div class="card-title"><%- icon('gauge', 18) %> بار تدریس و تخصیص‌ها</div>
<div style="padding:1rem">
  <div class="muted small">ساعت هفتگی تعریف‌شده<% if (t.weekly_load) { %> — موظفی <%= fa(t.weekly_load) %> ساعت<% } %></div>
  <div class="stat-big"><%= fa(hours) %> <small>ساعت<% if (t.weekly_load) { %> از <%= fa(t.weekly_load) %><% } %></small></div>
  <% if (t.weekly_load) { var pc = Math.min(100, Math.round(hours * 100 / t.weekly_load)); %><div class="meter"><i style="width:<%= pc %>%" class="<%= hours > t.weekly_load ? 'bad' : '' %>"></i></div><div class="small <%= hours > t.weekly_load ? '' : 'muted' %>" style="<%= hours > t.weekly_load ? 'color:var(--red)' : '' %>"><%= hours > t.weekly_load ? fa(hours - t.weekly_load) + ' ساعت بیش از موظفی' : hours === t.weekly_load ? 'برابر موظفی' : fa(t.weekly_load - hours) + ' ساعت تا موظفی' %></div><% } else { %><div class="small muted">موظفی تعیین نشده است.</div><% } %>
  <% if (enabled('timetable')) { %><h4 style="margin-top:1rem">توزیع روزانه در برنامه هفتگی<% if (t.daily_max) { %> <span class="muted small">(سقف <%= fa(t.daily_max) %> ساعت در روز)</span><% } %></h4>
  <div class="dist"><% days.forEach(function (d) { var n = byDay[d] || 0; %><span class="d <%= n ? 'on' : '' %> <%= t.daily_max && n > t.daily_max ? 'bad' : '' %>"><%= J.WEEKDAYS[d] %> <b><%= fa(n) %></b></span><% }) %></div><% } %>
  <% if (cap('hr.load.edit')) { %><form method="post" action="<%= u('/hr/teacher/' + t.id + '/load') %>" class="inline-form" style="margin-top:1rem"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="back" value="teacher">
    <label class="small">موظفی هفتگی <input type="number" name="weekly_load" min="0" max="60" value="<%= t.weekly_load || '' %>" style="width:80px"></label>
    <label class="small">سقف در روز <input type="number" name="daily_max" min="1" max="12" value="<%= t.daily_max || '' %>" style="width:80px"></label><button class="btn sm"><%- icon('save', 14) %> ذخیره سقف‌ها</button></form><% } %></div>
<% if (!assigned.length) { %><div class="empty">درسی اختصاص داده نشده است.</div><% } else { %><div class="table-wrap"><table class="t"><thead><tr><th>درس</th><th>کلاس</th><th class="center">ساعت</th><% if (cap('classes.curriculum')) { %><th></th><% } %></tr></thead><tbody><% assigned.forEach(function(a){ %><tr><td><%= a.subject_name %></td><td><a href="<%= u('/classes/' + a.classroom_id) %>"><%= a.class_name %></a></td><td class="center num"><%= fa(a.weekly_hours) %></td>
<% if (cap('classes.curriculum')) { %><td class="actions"><a class="btn sm ghost" title="برنامه‌ریزی دروس این کلاس" href="<%= u('/classes/' + a.classroom_id + '/curriculum') %>"><%- icon('sliders-horizontal', 14) %></a><form method="post" action="<%= u('/teachers/' + t.id + '/assignments') %>" style="display:inline" data-confirm="این تخصیص برداشته شود؟ (درس بدون معلم می‌ماند)"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="remove"><input type="hidden" name="cs_id" value="<%= a.id %>"><button class="btn sm ghost" style="color:var(--red)" title="برداشتن تخصیص"><%- icon('x', 14) %></button></form></td><% } %></tr><% }) %></tbody></table></div><% } %>
<% if (cap('classes.curriculum') && assignClasses.length) { %><form method="post" action="<%= u('/teachers/' + t.id + '/assignments') %>" class="toolbar" style="border-top:1px solid var(--border);border-bottom:0"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="add"><b class="small">تخصیص درس به این معلم:</b>
<select name="classroom_id" required><option value="">کلاس…</option><% assignClasses.forEach(function (c) { %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select>
<select name="subject_id" required><option value="">درس…</option><% assignSubjects.forEach(function (s) { %><option value="<%= s.id %>"><%= s.name %></option><% }) %></select>
<input type="number" name="weekly_hours" min="1" max="20" value="2" style="width:70px" aria-label="ساعت هفتگی"><button class="btn sm primary"><%- icon('plus', 14) %> تخصیص</button></form><% } %></div></div>
</div>
