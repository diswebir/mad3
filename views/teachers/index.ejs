<div class="page-head"><div><h1><%- icon('briefcase', 24) %> معلمان</h1><div class="muted small"><%= fa(total) %> معلم</div></div><div class="actions"><a class="btn" href="<%= u('/teachers/export.csv') %>"><%- icon('download', 16) %> CSV</a><a class="btn primary" href="<%= u('/teachers/new') %>"><%- icon('plus', 16) %> افزودن معلم</a></div></div>
<div class="card flush">
<form class="toolbar" method="get"><input type="text" name="q" value="<%= q %>" placeholder="نام، کد پرسنلی، تخصص، تلفن" style="min-width:240px"><select name="status" data-autosubmit><option value="">همه وضعیت‌ها</option><% Object.keys(L.teacherStatus).forEach(function(k){ %><option value="<%= k %>" <%= status === k ? 'selected' : '' %>><%= L.teacherStatus[k] %></option><% }) %></select><button class="btn"><%- icon('search', 15) %> جستجو</button></form>
<% if (!rows.length) { %><div class="empty"><%- icon('briefcase', 42) %><div>معلمی یافت نشد.</div></div><% } else { %>
<div class="table-wrap"><table class="t"><thead><tr><th>معلم</th><th>تخصص</th><th>کلاس راهنما</th><th>کلاس‌های تدریس</th><th>ساعت هفتگی</th><th>وضعیت</th><th></th></tr></thead><tbody>
<% rows.forEach(function(r){ var hr = homerooms.filter(function(h){ return h.homeroom_teacher_id === r.id; }); %><tr>
<td><div style="display:flex;gap:.6rem;align-items:center"><span class="avatar"><%= initials(r.full_name) %></span><div><a href="<%= u('/teachers/' + r.id) %>"><b><%= r.full_name %></b></a><div class="muted small ltr"><%= fa(r.phone || '') %></div></div></div></td>
<td><%= r.specialty || '—' %></td><td><%= hr.length ? hr.map(function(h){ return h.name; }).join('، ') : '—' %></td><td><%= fa(r.class_count) %></td><td><%= fa(r.hours) %></td><td><%- pill(L.teacherStatus[r.status] || r.status, r.status === 'active' ? 'green' : r.status === 'leave' ? 'amber' : 'gray') %></td>
<td class="actions"><a class="btn sm ghost" href="<%= u('/teachers/' + r.id) %>"><%- icon('eye', 15) %></a><% if (user.role === 'admin') { %><a class="btn sm ghost" title="سطح دسترسی" href="<%= u('/access/user/' + r.user_id) %>"><%- icon('key-round', 15) %></a><% } %><a class="btn sm ghost" href="<%= u('/teachers/' + r.id + '/edit') %>"><%- icon('pencil', 15) %></a></td></tr><% }) %>
</tbody></table></div><%- include('../partials/pager', { page: page, pages: pages }) %><% } %></div>
