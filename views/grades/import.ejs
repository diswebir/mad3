<div class="page-head"><div><div class="crumbs"><a href="<%= u('/grades/assessments/' + a.id) %>"><%= a.title %></a> / درون‌ریزی</div><h1><%- icon('file-down', 24) %> پیش‌نمایش درون‌ریزی نمرات</h1><div class="muted"><%= cs.subject_name %> — <%= cs.class_name %> — بیشینه‌ی نمره: <%= fa(a.max_score) %></div></div></div>
<div class="grid g3"><div class="card stat green" style="margin:0"><div><div class="v"><%= fa(result.valid.length) %></div><div class="l">ردیف معتبر</div></div></div><div class="card stat red" style="margin:0"><div><div class="v"><%= fa(result.errors.length) %></div><div class="l">ردیف دارای خطا (ثبت نمی‌شود)</div></div></div><div class="card stat amber" style="margin:0"><div><div class="v"><%= fa(result.missing.length) %></div><div class="l">دانش‌آموز بدون ردیف در فایل (بدون تغییر)</div></div></div></div>
<div class="card flush" style="margin-top:1rem"><div class="table-wrap"><table class="t"><thead><tr><th>ردیف</th><th>کد</th><th>دانش‌آموز</th><th>نمره</th><th>وضعیت</th></tr></thead><tbody>
<% result.entries.forEach(function(e){ %><tr><td><%= fa(e.row) %></td><td class="ltr num"><%= e.code %></td><td><%= e.student ? e.student.first_name + ' ' + e.student.last_name : '—' %></td><td class="num"><%= e.rawScore === '' ? '—' : fa(e.rawScore) %></td><td><%- e.error ? pill(e.error, 'red') : pill('معتبر', 'green') %></td></tr><% }) %></tbody></table></div></div>
<form method="post" action="<%= u('/grades/assessments/' + a.id + '/import/commit') %>" style="margin-top:1rem"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="payload" value="<%= payload %>">
<button class="btn primary" <%= result.valid.length ? '' : 'disabled' %>><%- icon('check', 16) %> ثبت <%= fa(result.valid.length) %> نمره‌ی معتبر</button> <a class="btn" href="<%= u('/grades/assessments/' + a.id) %>">انصراف</a></form>
