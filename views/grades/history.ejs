<div class="page-head"><div><div class="crumbs"><a href="<%= u('/grades') %>">نمرات</a> / <a href="<%= u('/grades/assessments/' + a.id) %>"><%= a.title %></a></div><h1><%- icon('history', 24) %> تاریخچه‌ی نمرات</h1><div class="muted"><%= cs.subject_name %> — <%= cs.class_name %> — <%= a.title %> (آخرین ۵۰۰ رویداد)</div></div></div>
<div class="card flush"><% if (!rows.length) { %><div class="empty" style="padding:1.5rem">هنوز تغییری ثبت نشده است.</div><% } else { %><div class="table-wrap"><table class="t"><thead><tr><th>زمان</th><th>دانش‌آموز</th><th>نمره‌ی قبلی</th><th>نمره‌ی جدید</th><th>رویداد</th><th>منبع</th><th>کاربر</th><th>دلیل</th></tr></thead><tbody>
<% var ACT = { set: 'ثبت', edit: 'ویرایش', clear: 'پاک‌کردن', lock: 'قفل', unlock: 'باز کردن قفل', delete: 'حذف ارزشیابی' }; var SRC = { manual: 'دستی', import: 'درون‌ریزی', system: 'سامانه' }; %>
<% rows.forEach(function(h){ %><tr><td class="nowrap small"><%= dt(h.created_at) %></td><td><%= h.student_id ? (h.first_name || '؟') + ' ' + (h.last_name || '') : '—' %></td><td class="num"><%= h.old_value === null ? '—' : fa(Number(h.old_value)) %></td><td class="num"><b><%= h.new_value === null ? '—' : fa(Number(h.new_value)) %></b></td><td><span class="badge <%= h.action === 'edit' ? 'amber' : h.action === 'lock' || h.action === 'delete' ? 'red' : 'blue' %>"><%= ACT[h.action] || h.action %></span></td><td class="small"><%= SRC[h.source] || h.source %></td><td class="small"><%= h.user_name || '—' %></td><td class="small"><%= h.reason || '' %></td></tr><% }) %></tbody></table></div><% } %></div>
