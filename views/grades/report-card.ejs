<div class="page-head no-print"><div><h1><%- icon('award', 24) %> کارنامه</h1></div><div class="actions"><button class="btn primary" data-print><%- icon('printer', 16) %> چاپ</button><% if (user.role !== 'student') { %><a class="btn" href="<%= u('/students/' + s.id) %>">پرونده دانش‌آموز</a><% } %></div></div>
<div class="tabs no-print"><a class="<%= !term ? 'active' : '' %>" href="?">کل سال</a><% for (var i = 1; i <= terms; i++) { %><a class="<%= term === i ? 'active' : '' %>" href="?term=<%= i %>">نوبت <%= fa(i) %></a><% } %></div>
<div class="card">
  <div style="text-align:center;margin-bottom:1rem"><h2 style="margin:0"><%= S('school_name') %></h2><div class="muted">کارنامه تحصیلی <%= term ? 'نوبت ' + fa(term) : 'کل سال' %> — سال تحصیلی <%= fa(year ? year.title : '') %></div></div>
  <div class="grid g3" style="margin-bottom:1rem"><div><span class="muted">نام:</span> <b><%= s.first_name %> <%= s.last_name %></b></div><div><span class="muted">شماره دانش‌آموزی:</span> <b><%= fa(s.student_code) %></b></div><div><span class="muted">کلاس:</span> <b><%= s.class_name || '—' %></b> <span class="muted small">(راهنما: <%= s.homeroom_name || '—' %>)</span></div></div>
  <% if (!r || !me || (me.overall === null && !(r.partial && Object.keys(me.subjects).length))) { %><div class="empty">نمره‌ای ثبت یا منتشر نشده است.</div><% } else { %>
  <% if (r.partial) { %><div class="alert info no-print" style="margin-bottom:1rem"><%- icon('info', 18) %><div>شما معلم راهنمای این کلاس نیستید؛ فقط نمرات دروس خودتان نمایش داده می‌شود (بدون معدل کل و رتبه).</div></div><% } %>
  <div class="table-wrap"><table class="t"><thead><tr><th>درس</th><th>ضریب</th><th>معلم</th><th>میانگین دانش‌آموز</th><th>میانگین کلاس</th><th>وضعیت</th></tr></thead><tbody>
  <% r.subjects.forEach(function(c){ var v = me.subjects[c.id]; %><tr><td><b><%= c.name %></b></td><td class="num"><%= fa(c.coefficient) %></td><td><%= c.teacher_name || '—' %></td><td class="num"><b><%= v ? fa(v.avg) : '—' %></b></td><td class="num muted"><%= !showRank || subjectAvg[c.id] === null || subjectAvg[c.id] === undefined ? '—' : fa(subjectAvg[c.id]) %></td><td><%- v ? (v.passed ? pill('قبول', 'green') : pill('مردود', 'red')) : '<span class="muted">—</span>' %></td></tr><% }) %></tbody></table></div>
  <% if (!r.partial) { %>
  <div class="grid g4" style="margin-top:1rem"><div class="card stat" style="margin:0"><div><div class="v"><%= fa(me.overall) %></div><div class="l">معدل از <%= fa(r.scale) %></div></div></div><% if (showRank) { %><div class="card stat green" style="margin:0"><div><div class="v"><%= me.rank ? fa(me.rank) + ' از ' + fa(r.rankedCount) : '—' %></div><div class="l">رتبه در کلاس</div></div></div><div class="card stat amber" style="margin:0"><div><div class="v"><%= classAvg === null ? '—' : fa(classAvg) %></div><div class="l">معدل کلاس</div></div></div><% } %>
    <div class="card stat <%= me.overall >= r.pass ? 'green' : 'red' %>" style="margin:0"><div><div class="v"><%= me.overall >= r.pass ? 'قبول' : 'مردود' %></div><div class="l">نتیجه</div></div></div></div>
  <% } %>
  <% } %>
  <% if (typeof att !== 'undefined' || typeof behavior !== 'undefined') { %><div style="margin-top:1rem;display:flex;gap:2rem;flex-wrap:wrap"><% if (typeof att !== 'undefined') { %><span>غیبت غیرموجه: <b><%= fa(att.absent || 0) %></b> روز</span><span>غیبت موجه: <b><%= fa(att.excused || 0) %></b></span><span>تأخیر: <b><%= fa(att.late || 0) %></b> بار</span><% } %><% if (typeof behavior !== 'undefined') { %><span>نمره رفتار: <b><%= fa(behavior) %></b></span><% } %></div><% } %>
  <div style="display:flex;justify-content:space-between;margin-top:3rem" class="print-only"><span>امضای معلم راهنما</span><span>مهر و امضای مدیر</span></div>
</div>
