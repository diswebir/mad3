<div class="page-head"><div><div class="crumbs"><a href="<%= u('/classes/' + c.id) %>"><%= c.name %></a></div><h1><%- icon('trophy', 24) %> کارنامه کلاس <%= c.name %></h1><div class="muted">میانگین دروس، معدل و رتبه — مقیاس <%= fa(r.scale) %> — حدنصاب <%= fa(r.pass) %></div></div>
<div class="actions"><a class="btn" href="<%= qs({format: 'csv'}) %>"><%- icon('download', 16) %> CSV</a><button class="btn" data-print><%- icon('printer', 16) %> چاپ</button></div></div>
<div class="tabs"><a class="<%= !term ? 'active' : '' %>" href="?">کل سال</a><% for (var i = 1; i <= terms; i++) { %><a class="<%= term === i ? 'active' : '' %>" href="?term=<%= i %>">نوبت <%= fa(i) %></a><% } %></div>
<div class="card flush"><% if (!r.students.length) { %><div class="empty">دانش‌آموزی در کلاس نیست.</div><% } else { %><div class="table-wrap"><table class="t"><thead><tr><th>رتبه</th><th>دانش‌آموز</th><% r.subjects.forEach(function(s){ %><th title="<%= s.teacher_name || '' %>"><%= s.name %></th><% }) %><th>معدل</th></tr></thead><tbody>
<% r.students.slice().sort(function(a, b){ return (a.rank || 999) - (b.rank || 999); }).forEach(function(s){ %><tr><td><%- s.rank ? (s.rank <= 3 ? '<span class="badge amber">' + fa(s.rank) + '</span>' : fa(s.rank)) : '—' %></td><td class="nowrap"><a href="<%= u('/grades/report-card/' + s.id) %>"><%= s.first_name %> <%= s.last_name %></a></td>
<% r.subjects.forEach(function(x){ var v = s.subjects[x.id]; %><td class="num" style="<%= v && !v.passed ? 'color:var(--red);font-weight:700' : '' %>"><%= v ? fa(v.avg) : '—' %></td><% }) %><td class="num"><b><%= s.overall === null ? '—' : fa(s.overall) %></b></td></tr><% }) %></tbody></table></div><% } %></div>
