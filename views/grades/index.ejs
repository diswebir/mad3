<div class="page-head"><div><h1><%- icon('award', 24) %> نمرات و ارزشیابی</h1><div class="muted">یک درس-کلاس را برای ثبت ارزشیابی و نمره انتخاب کنید.</div></div>
<% if (isManager) { %><div class="actions"><form method="get"><select name="class_id" data-autosubmit style="width:auto"><option value="">همه کلاس‌ها</option><% classes.forEach(function(c){ %><option value="<%= c.id %>" <%= String(classId) === String(c.id) ? 'selected' : '' %>><%= c.name %></option><% }) %></select></form></div><% } %></div>
<div class="card flush"><% if (!rows.length) { %><div class="empty"><%- icon('award', 42) %><div>درسی برای شما تعریف نشده است.</div></div><% } else { %>
<div class="table-wrap"><table class="t"><thead><tr><th>کلاس</th><th>درس</th><th>معلم</th><th>ارزشیابی‌ها</th><th></th></tr></thead><tbody>
<% rows.forEach(function(r){ %><tr><td><a href="<%= u('/grades/class/' + r.classroom_id) %>"><%= r.class_name %></a></td><td><b><%= r.subject_name %></b></td><td><%= r.teacher_name || '—' %></td><td><%= fa(r.a_count) %></td><td class="actions"><a class="btn sm" href="<%= u('/grades/cs/' + r.id) %>"><%- icon('pencil', 15) %> ثبت نمره</a></td></tr><% }) %></tbody></table></div><% } %></div>
