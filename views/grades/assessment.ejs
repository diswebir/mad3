<div class="page-head"><div><div class="crumbs"><a href="<%= u('/grades') %>">نمرات</a> / <a href="<%= u('/grades/cs/' + cs.id) %>"><%= cs.subject_name %> — <%= cs.class_name %></a></div><h1><%= a.title %> <%- a.published ? pill('منتشر شده', 'green') : pill('پیش‌نویس', 'amber') %></h1><div class="muted"><%= L.assessmentType[a.type] %> — بیشینه <%= fa(a.max_score) %> — وزن <%= fa(a.weight) %> — نوبت <%= fa(a.term) %> — <%= d(a.date) %></div></div>
<div class="actions"><form method="post" action="<%= u('/grades/assessments/' + a.id + '/publish') %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn <%= a.published ? '' : 'success' %>"><%- icon(a.published ? 'x' : 'send', 16) %> <%= a.published ? 'لغو انتشار' : 'انتشار نمرات' %></button></form>
<form method="post" action="<%= u('/grades/assessments/' + a.id + '/delete') %>" data-confirm="ارزشیابی و تمام نمرات آن حذف شود؟"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn danger"><%- icon('trash-2', 16) %> حذف</button></form></div></div>
<div class="grid g-side"><div>
<form method="post" action="<%= u('/grades/assessments/' + a.id + '/scores') %>"><input type="hidden" name="_csrf" value="<%= csrf %>">
<div class="card flush"><div class="table-wrap"><table class="t"><thead><tr><th>#</th><th>دانش‌آموز</th><th>نمره (از <%= fa(a.max_score) %>)</th><th>توضیح</th></tr></thead><tbody>
<% students.forEach(function(s, i){ var sc = scores[s.id]; %><tr><td><%= fa(i + 1) %></td><td><a href="<%= u('/students/' + s.id) %>"><%= s.first_name %> <%= s.last_name %></a></td><td><input class="score-in digits ltr" type="text" inputmode="decimal" name="score[<%= s.id %>]" value="<%= sc && sc.score !== null ? sc.score : '' %>" max="<%= a.max_score %>" autocomplete="off"></td><td><input type="text" name="note[<%= s.id %>]" value="<%= sc && sc.note ? sc.note : '' %>" maxlength="250" placeholder="مثلاً غایب" style="min-width:140px"></td></tr><% }) %>
<% if (!students.length) { %><tr><td colspan="4" class="empty">دانش‌آموزی در کلاس نیست.</td></tr><% } %></tbody></table></div></div>
<button class="btn primary"><%- icon('save', 16) %> ذخیره نمرات</button><span class="muted small"> خانه خالی = نمره‌ای ثبت نمی‌شود (در میانگین لحاظ نخواهد شد).</span></form></div>
<div>
<% if (stats) { %><div class="card"><h3><%- icon('chart-bar', 18) %> آمار</h3><dl class="kv" style="grid-template-columns:100px 1fr"><dt>تعداد نمره</dt><dd><%= fa(stats.n) %></dd><dt>میانگین</dt><dd><b><%= fa(stats.avg) %></b></dd><dt>بیشترین</dt><dd><%= fa(stats.max) %></dd><dt>کمترین</dt><dd><%= fa(stats.min) %></dd><dt>قبولی</dt><dd><%= fa(stats.passed) %> از <%= fa(stats.n) %></dd></dl>
<h4 style="margin-top:1rem">توزیع نمرات</h4><div class="bars"><% ['۰ تا ۲۵٪', '۲۵ تا ۵۰٪', '۵۰ تا ۷۵٪', '۷۵ تا ۱۰۰٪'].forEach(function(l, i){ %><div class="row" style="grid-template-columns:80px 1fr 30px"><span class="small"><%= l %></span><div class="progress"><i style="width:<%= Math.round(stats.bins[i] * 100 / stats.n) %>%"></i></div><span><%= fa(stats.bins[i]) %></span></div><% }) %></div></div><% } %>
<form class="card" method="post" action="<%= u('/grades/assessments/' + a.id + '/update') %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><h3><%- icon('pencil', 18) %> ویرایش مشخصات</h3>
<div class="field" style="margin-bottom:.6rem"><label>عنوان</label><input type="text" name="title" value="<%= a.title %>" required></div>
<div class="form-grid"><div class="field"><label>نوع</label><select name="type"><% Object.keys(L.assessmentType).forEach(function(k){ %><option value="<%= k %>" <%= a.type === k ? 'selected' : '' %>><%= L.assessmentType[k] %></option><% }) %></select></div><div class="field"><label>نوبت</label><select name="term"><% for (var i = 1; i <= terms; i++) { %><option value="<%= i %>" <%= a.term === i ? 'selected' : '' %>><%= fa(i) %></option><% } %></select></div>
<div class="field"><label>بیشینه</label><input type="text" class="digits ltr" name="max_score" value="<%= a.max_score %>"></div><div class="field"><label>وزن</label><input type="text" class="digits ltr" name="weight" value="<%= a.weight %>"></div></div>
<div class="field" style="margin-top:.6rem"><label>تاریخ</label><input class="jdate ltr" type="text" name="date" value="<%= assessmentVals.date %>" autocomplete="off"></div><input type="hidden" name="published" value="<%= a.published ? 1 : 0 %>">
<button class="btn" style="margin-top:.8rem">ذخیره مشخصات</button></form>
</div></div>
