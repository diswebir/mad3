<div class="page-head"><div><h1><%- icon('database-backup', 24) %> پشتیبان‌گیری و بازیابی</h1><div class="muted">از داده‌ها به‌صورت منظم نسخه پشتیبان بگیرید.</div></div></div>
<div class="alert <%= off.on ? (off.err ? 'warn' : 'success') : 'info' %>"><%- icon('cloud-upload', 18) %><div><% if (!off.on) { %><b>نسخه‌ی بیرون از هاست غیرفعال است.</b> اگر هاست یا دیسک آسیب ببیند، پشتیبان‌های همین سرور هم از بین می‌روند. <a href="<%= u('/super/offsite') %>">راه‌اندازی پشتیبان بیرونی</a>
  <% } else { %><b>پشتیبان بیرونی فعال است (<%= off.type === 's3' ? 'S3' : off.type === 'webdav' ? 'WebDAV' : 'پوشه' %>).</b> <%= off.err ? 'آخرین ارسال ناموفق بود: ' + off.err : (off.ok ? 'آخرین ارسال موفق: ' + dt(String(off.ok).replace('T', ' ').slice(0, 19)) : 'هنوز ارسالی انجام نشده است.') %> <a href="<%= u('/super/offsite') %>">جزئیات</a><% } %></div></div>
<div class="grid g2">
<div class="card"><h3><%- icon('download', 18) %> دریافت پشتیبان</h3><p class="muted">خروجی JSON شامل تمام اطلاعات (دانش‌آموزان، معلمان، حضور و غیاب، نمرات، تیکت‌ها، مالی و ...) است. فایل‌های بارگذاری‌شده (عکس و مدارک) در پوشه <span class="ltr">data/uploads</span> نگهداری می‌شوند و باید جداگانه کپی شوند.</p>
<dl class="kv" style="grid-template-columns:100px 1fr"><dt>کاربران</dt><dd><%= fa(counts.users) %></dd><dt>دانش‌آموزان</dt><dd><%= fa(counts.students) %></dd><dt>رکورد حضور</dt><dd><%= fa(counts.attendance) %></dd><dt>تیکت‌ها</dt><dd><%= fa(counts.tickets) %></dd></dl>
<div style="display:flex;gap:.6rem;margin-top:1rem;flex-wrap:wrap"><form method="post" action="<%= u('/backup/download') %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn primary"><%- icon('download', 16) %> دانلود پشتیبان (JSON)</button></form>
<% if (sqlite) { %><form method="post" action="<%= u('/backup/sqlite') %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn"><%- icon('database-backup', 16) %> دانلود فایل SQLite</button></form><% } %></div></div>
<form class="card" method="post" enctype="multipart/form-data" action="<%= u('/backup/restore') %>?_csrf=<%= csrf %>" style="border-color:var(--red)"><h3 style="color:var(--red)"><%- icon('triangle-alert', 18) %> بازیابی از پشتیبان</h3><p class="muted">با بازیابی، <b>تمام داده‌های فعلی جایگزین</b> می‌شوند و همه کاربران از سامانه خارج می‌شوند. قبل از اقدام یک پشتیبان از وضعیت فعلی بگیرید.</p>
<div class="field"><label>فایل پشتیبان (JSON یا نسخه‌ی رمزنگاری‌شده‌ی .enc)</label><input type="file" name="file" accept=".json,.gz,.enc,application/json" required></div><div class="field" style="margin-top:.6rem"><label>عبارت رمز (فقط برای فایل .enc)</label><input type="password" class="ltr" name="passphrase" autocomplete="off" data-no-toggle="1"></div><div class="field" style="margin-top:.6rem"><label>برای تأیید عبارت <b class="ltr">RESTORE</b> را بنویسید</label><input type="text" class="ltr" name="confirm" required autocomplete="off"></div>
<button class="btn danger" style="margin-top:.8rem" data-confirm="بازیابی تمام داده‌های فعلی را حذف می‌کند. مطمئنید؟"><%- icon('upload', 16) %> بازیابی</button></form></div>
<div class="card flush" style="margin-top:1rem"><div class="card-title" style="padding:.8rem 1rem;justify-content:space-between"><span><%- icon('hard-drive', 18) %> نسخه‌های ذخیره‌شده روی سرور <span class="badge"><%= fa(files.length) %></span></span>
<form method="post" action="<%= u('/backup/now') %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm primary"><%- icon('save', 14) %> پشتیبان‌گیری هم‌اکنون</button></form></div>
<div class="muted small" style="padding:0 1rem .6rem">پشتیبان خودکار روزانه: <b><%= autoOn ? 'فعال' : 'غیرفعال' %></b> (نگه‌داری <%= fa(keep) %> نسخه) — <%= lastAuto ? 'آخرین: ' + dt(new Date(lastAuto.mtime).toISOString().replace('T', ' ').slice(0, 19)) : 'هنوز انجام نشده' %>. پیش از ارتقای پایان سال و هر بازیابی هم به‌طور خودکار نسخه گرفته می‌شود. کلید API پیامک در فایل‌های پشتیبان ذخیره نمی‌شود. تنظیمات: <a href="<%= u('/settings') %>">تنظیمات ← نگهداری</a></div>
<% if (!files.length) { %><div class="empty" style="padding:1rem">هنوز نسخه‌ای ذخیره نشده است.</div><% } else { %><div class="table-wrap"><table class="t"><thead><tr><th>فایل</th><th>نوع</th><th>حجم</th><th></th></tr></thead><tbody>
<% var KIND = { auto: 'خودکار روزانه', manual: 'دستی', 'pre-promotion': 'پیش از ارتقا', 'pre-restore': 'پیش از بازیابی' }; files.forEach(function(f){ %><tr><td class="ltr small"><%= f.name %></td><td><span class="badge <%= f.kind === 'auto' ? 'blue' : 'amber' %>"><%= KIND[f.kind] || f.kind %></span></td><td class="num"><%= fa(Math.max(1, Math.round(f.size / 1024))) %> KB</td>
<td style="display:flex;gap:.3rem;flex-wrap:wrap"><a class="btn sm" href="<%= u('/backup/files/' + f.name) %>"><%- icon('download', 14) %></a>
<form method="post" action="<%= u('/backup/files/' + f.name + '/restore') %>" style="display:flex;gap:.3rem"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="text" name="confirm" class="ltr" placeholder="RESTORE" style="width:90px" autocomplete="off"><button class="btn sm danger" data-confirm="بازیابی تمام داده‌های فعلی را جایگزین می‌کند (پیش از آن یک نسخه‌ی خودکار گرفته می‌شود). ادامه؟">بازیابی</button></form>
<form method="post" action="<%= u('/backup/files/' + f.name + '/delete') %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm ghost" data-confirm="این نسخه حذف شود؟" style="color:var(--red)"><%- icon('trash-2', 14) %></button></form></td></tr><% }) %></tbody></table></div><% } %></div>
