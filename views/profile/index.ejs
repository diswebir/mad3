<div class="page-head"><h1><%- icon('user-round', 24) %> پروفایل من</h1></div>
<div class="grid g-side">
<form class="card" method="post" enctype="multipart/form-data" action="<%= u('/profile') %>?_csrf=<%= csrf %>">
  <% if (errors.length) { %><div class="alert error"><ul><% errors.forEach(function(e){ %><li><%= e %></li><% }) %></ul></div><% } %>
  <div style="display:flex;gap:1rem;align-items:center;margin-bottom:1rem"><span class="avatar lg"><% if (user.avatar) { %><img src="<%= fileUrl('photos', user.avatar) %>" alt=""><% } else { %><%= initials(user.full_name) %><% } %></span><div class="field" style="flex:1"><label>تصویر پروفایل (حداکثر ۲ مگابایت)</label><input type="file" name="avatar" accept="image/*"></div></div>
  <div class="form-grid">
    <div class="field"><label>نام و نام خانوادگی</label><input type="text" name="full_name" value="<%= user.full_name %>" <%= user.role === 'student' ? 'readonly' : '' %>><% if (user.role === 'student') { %><div class="hint">برای تغییر نام با مدیریت مدرسه تماس بگیرید.</div><% } %></div>
    <div class="field"><label>نام کاربری</label><input type="text" class="ltr" value="<%= user.username %>" readonly></div>
    <div class="field"><label>ایمیل</label><input type="text" class="ltr" name="email" value="<%= user.email || '' %>"></div>
    <div class="field"><label>شماره تماس</label><input type="text" class="ltr" name="phone" value="<%= user.phone || '' %>"></div>
  </div>
  <div class="form-actions"><button class="btn primary" type="submit"><%- icon('save', 16) %> ذخیره</button><a class="btn" href="<%= u('/profile/password') %>"><%- icon('key-round', 16) %> تغییر رمز</a></div>
</form>
<div class="card"><h3>اطلاعات حساب</h3><dl class="kv" style="grid-template-columns:90px 1fr"><dt>نقش</dt><dd><%= L.roles[user.isSuper ? "superadmin" : user.role] %></dd><dt>آخرین ورود</dt><dd><%= user.last_login ? dt(user.last_login) : '—' %></dd><dt>عضویت</dt><dd><%= d(user.created_at) %></dd></dl></div>
</div>
