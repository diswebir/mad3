<div class="page-head"><h1><%- icon('key-round', 24) %> تغییر رمز عبور</h1></div>
<form class="card" style="max-width:520px" method="post" action="<%= u('/profile/password') %>" autocomplete="off">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <% if (force) { %><div class="alert warn"><%- icon('triangle-alert', 18) %><div>برای ادامه باید رمز عبور اولیه خود را تغییر دهید.</div></div><% } %>
  <% if (errors.length) { %><div class="alert error"><ul><% errors.forEach(function(e){ %><li><%= e %></li><% }) %></ul></div><% } %>
  <div class="field" style="margin-bottom:.9rem"><label>رمز عبور فعلی</label><input type="password" class="ltr" name="current" required autocomplete="current-password"></div>
  <div class="field" style="margin-bottom:.9rem"><label>رمز عبور جدید</label><input type="password" class="ltr" name="password" required autocomplete="new-password"><div class="hint">حداقل <%= fa(S('min_password_length')) %> نویسه</div></div>
  <div class="field"><label>تکرار رمز جدید</label><input type="password" class="ltr" name="password2" required autocomplete="new-password"></div>
  <div class="form-actions"><button class="btn primary" type="submit"><%- icon('save', 16) %> تغییر رمز</button></div>
</form>
