<%- include('_head', { heading: 'انتخاب ماژول‌ها', lead: 'هر بخش سامانه یک ماژول است. موارد موردنیاز را روشن بگذارید؛ هر زمان خواستید (سوپر ادمین) خاموش/روشن می‌شود.' }) %>
<form method="post" id="mod-form" autocomplete="off">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="iw-toolbar">
    <div class="search"><%- icon('search', 16) %><input type="search" id="mod-q" placeholder="جستجوی ماژول…" aria-label="جستجوی ماژول"></div>
    <div class="btns"><button type="button" class="btn sm" data-mods="all">همه</button><button type="button" class="btn sm" data-mods="none">هیچ‌کدام (جز پایه)</button><span class="chip" id="mod-count" aria-live="polite"></span></div>
  </div>
  <% groups.forEach(function (g) { %>
  <section class="iw-group" data-group>
    <h3><%= g.title %></h3>
    <div class="iw-mods">
      <% g.mods.forEach(function (m) { var on = m.core || chosen.includes(m.key); %>
      <label class="iw-mod <%= m.core ? 'core' : '' %>" data-name="<%= m.title %> <%= m.desc %>">
        <span class="ico"><%- icon(m.icon, 20) %></span>
        <span class="tx"><b><%= m.title %></b><% if (m.core) { %> <span class="badge blue">پایه</span><% } %><small><%= m.desc %></small></span>
        <span class="switch"><input type="checkbox" name="modules" value="<%= m.key %>" <%= on ? 'checked' : '' %> <%= m.core ? 'disabled' : '' %>><span></span></span>
      </label>
      <% }) %>
    </div>
  </section>
  <% }) %>
  <div class="iw-empty" id="mod-empty" hidden>ماژولی با این عبارت پیدا نشد.</div>
  <div class="iw-card demo">
    <label class="check"><input type="checkbox" name="demo" value="1" <%= demo ? 'checked' : '' %>> <span><b><%- icon('flask-conical', 16) %> نصب داده‌های نمونه (دمو)</b>
      <span class="muted small" style="display:block">۱۰ معلم، ۶ کلاس، ۷۲ دانش‌آموز با حضور و غیاب، نمرات، تیکت و … — برای آشنایی و آموزش عالی است؛ برای استفاده‌ی واقعی تیک را بردارید تا سامانه خالی نصب شود.</span></span></label>
  </div>
  <div class="iw-actions"><button class="btn primary lg" type="submit">ادامه <%- icon('chevron-left', 18) %></button><a class="btn ghost" href="<%= u('/install/admin') %>">بازگشت</a></div>
</form>
<%- include('_foot') %>
