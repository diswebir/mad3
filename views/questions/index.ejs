<div class="page-head"><div><h1><%- icon('circle-help', 24) %> بانک سؤال</h1><div class="muted small"><%= fa(total) %> سؤال</div></div><div class="actions"><a class="btn" href="<%= u('/papers') %>"><%- icon('clipboard-pen', 16) %> برگه‌های امتحانی</a><a class="btn primary" href="<%= u('/questions/new') %>"><%- icon('plus', 16) %> سؤال جدید</a></div></div>
<form class="card toolbar" method="get"><select name="subject_id" data-autosubmit><option value="">همه‌ی دروس</option><% subjects.forEach(function(s){ %><option value="<%= s.id %>" <%= String(f.subject_id) === String(s.id) ? 'selected' : '' %>><%= s.name %></option><% }) %></select>
<select name="type" data-autosubmit><option value="">همه‌ی انواع</option><% Object.keys(TYPES).forEach(function(t){ %><option value="<%= t %>" <%= f.type === t ? 'selected' : '' %>><%= TYPES[t] %></option><% }) %></select>
<select name="difficulty" data-autosubmit><option value="">همه‌ی سطوح</option><% Object.keys(DIFF).forEach(function(t){ %><option value="<%= t %>" <%= String(f.difficulty) === t ? 'selected' : '' %>><%= DIFF[t] %></option><% }) %></select>
<input type="text" name="q" value="<%= f.q || '' %>" placeholder="جستجو در متن سؤال"><button class="btn"><%- icon('filter', 15) %> اعمال</button></form>
<div class="card flush"><div class="table-wrap"><table class="t"><thead><tr><th>سؤال</th><th>درس</th><th>نوع</th><th>سطح</th><th>بارم</th><th></th></tr></thead><tbody>
<% if (!rows.length) { %><tr><td colspan="6" class="muted" style="text-align:center">سؤالی ثبت نشده است.</td></tr><% } %>
<% rows.forEach(function(q){ %><tr><td style="max-width:420px"><%= q.text.length > 140 ? q.text.slice(0, 140) + '…' : q.text %></td><td><%= q.subject_name %></td><td><%= TYPES[q.type] %></td><td><%- pill(DIFF[q.difficulty], ({1:'green',2:'amber',3:'red'})[q.difficulty]) %></td><td class="num"><%= fa(Number(q.score)) %></td>
<td class="actions"><a class="btn sm ghost" href="<%= u('/questions/' + q.id + '/edit') %>"><%- icon('pencil', 15) %></a><form method="post" action="<%= u('/questions/' + q.id + '/delete') %>" style="display:inline" data-confirm="حذف شود؟"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm ghost" style="color:var(--red)"><%- icon('trash-2', 15) %></button></form></td></tr><% }) %></tbody></table></div>
<%- include('../partials/pager', { page: page, pages: pages }) %></div>
