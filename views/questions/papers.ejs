<div class="page-head"><div><h1><%- icon('clipboard-pen', 24) %> برگه‌های امتحانی</h1></div><div class="actions"><a class="btn" href="<%= u('/questions') %>">بانک سؤال</a><a class="btn primary" href="<%= u('/papers/new') %>"><%- icon('plus', 16) %> برگه‌ی جدید</a></div></div>
<div class="card flush"><div class="table-wrap"><table class="t"><thead><tr><th>عنوان</th><th>درس / کلاس</th><th>تاریخ</th><th>مدت</th><th>سؤال‌ها</th><th></th></tr></thead><tbody>
<% if (!rows.length) { %><tr><td colspan="6" class="muted" style="text-align:center">برگه‌ای ساخته نشده است.</td></tr><% } %>
<% rows.forEach(function(p){ %><tr><td><a href="<%= u('/papers/' + p.id) %>"><b><%= p.title %></b></a></td><td><%= p.subject_name %> — <%= p.class_name %></td><td><%= p.exam_date ? d(p.exam_date) : '—' %></td><td><%= fa(p.duration) %> دقیقه</td><td><%= fa(p.count) %></td>
<td class="actions"><a class="btn sm" href="<%= u('/papers/' + p.id) %>">مشاهده/چاپ</a><form method="post" action="<%= u('/papers/' + p.id + '/delete') %>" style="display:inline" data-confirm="حذف شود؟"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm ghost" style="color:var(--red)"><%- icon('trash-2', 15) %></button></form></td></tr><% }) %></tbody></table></div></div>
