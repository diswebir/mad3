<div class="tabs" style="margin-bottom:1rem"><% if (user.role !== 'teacher') { %><a href="<%= u('/hr') %>" class="<%= active === 'index' ? 'active' : '' %>">نمای کلی</a><% } else if (user.teacher) { %><a href="<%= u('/hr/teacher/' + user.teacher.id) %>" class="<%= active === 'me' ? 'active' : '' %>">پرونده من</a><% } %><a href="<%= u('/hr/leaves') %>" class="<%= active === 'leaves' ? 'active' : '' %>">مرخصی‌ها</a><% if (user.role !== 'teacher' && enabled('timetable')) { %><a href="<%= u('/timetable/substitutes') %>">جانشینی</a><% } %></div>
