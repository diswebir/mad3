<div class="page-head"><div><h1><%- icon('user-cog', 24) %> <%= t.full_name %></h1><div class="muted"><%= t.specialty || '' %> <%= t.personnel_code ? '· کد پرسنلی ' + fa(t.personnel_code) : '' %></div></div><div class="actions"><% if (isM) { %><a class="btn primary" href="<%= u('/hr/evaluations/new?teacher_id=' + t.id) %>">ارزشیابی</a><a class="btn" href="<%= u('/hr/leaves/new') %>">ثبت مرخصی</a><% } else { %><a class="btn primary" href="<%= u('/hr/leaves/new') %>">درخواست مرخصی</a><% } %></div></div>
<%- include('_nav', { active: isM ? 'index' : 'me' }) %>
<div class="grid g3">
<div class="card"><h3>موظفی</h3><div class="stat-big"><%= fa(hours) %> <small>ساعت در هفته</small></div><div class="muted">موظفی: <%= t.weekly_load ? fa(t.weekly_load) : 'تعیین نشده' %> <% if (load.state === 'over') { %>— <b style="color:var(--red)"><%= fa(load.diff) %> ساعت اضافه‌تدریس</b><% } else if (load.state === 'under') { %>— <%= fa(-load.diff) %> ساعت کمتر از موظفی<% } %></div>
<% if (isM) { %><form method="post" action="<%= u('/hr/teacher/' + t.id + '/load') %>" style="margin-top:.6rem;display:flex;gap:.4rem"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="number" name="weekly_load" min="0" max="60" value="<%= t.weekly_load === null || t.weekly_load === undefined ? '' : t.weekly_load %>" style="width:90px" placeholder="ساعت"><button class="btn sm">ذخیره</button></form><% } %></div>
<div class="card"><h3>مرخصی سال جاری</h3><div class="stat-big"><%= fa(ls.casual) %> <small>از <%= fa(ls.quota) %> روز استحقاقی</small></div><div class="muted">مانده: <%= fa(ls.left) %> روز · سایر مرخصی‌ها: <%= fa(ls.other) %> روز</div></div>
<div class="card"><h3>جانشینی</h3><div class="muted">به‌عنوان جانشین: <b><%= fa(given) %></b> ساعت · کلاس‌های جایگزین‌شده‌ی او: <b><%= fa(missed) %></b></div></div></div>
<div class="grid g2"><div class="card flush"><div class="card-title">کلاس‌ها و دروس</div><table class="t"><tbody><% if (!classes.length) { %><tr><td class="muted">درسی تخصیص داده نشده.</td></tr><% } %><% classes.forEach(function(c){ %><tr><td><%= c.class_name %></td><td><%= c.subject_name %></td><td class="num"><%= fa(c.weekly_hours || 0) %> ساعت</td></tr><% }) %></tbody></table></div>
<div class="card flush"><div class="card-title">سوابق مرخصی</div><table class="t"><tbody><% if (!leaves.length) { %><tr><td class="muted">سابقه‌ای نیست.</td></tr><% } %><% leaves.forEach(function(l){ %><tr><td><%= LK[l.kind] || l.kind %></td><td><%= d(l.start_date) %> تا <%= d(l.end_date) %></td><td class="num"><%= fa(l.days) %> روز</td><td><%- pill(LS[l.status] || l.status, l.status === 'approved' ? 'green' : l.status === 'rejected' ? 'red' : 'amber') %></td></tr><% }) %></tbody></table></div></div>
<div class="card flush"><div class="card-title">ارزشیابی‌ها</div><div class="table-wrap"><table class="t"><thead><tr><th>تاریخ</th><th>نوبت</th><% CR.forEach(function(c){ %><th title="<%= c.label %>"><%= c.label.split(' ')[0] %></th><% }) %><th>جمع (از ۲۰)</th><th>توضیح</th><th>ارزیاب</th><th></th></tr></thead><tbody>
<% if (!evals.length) { %><tr><td colspan="12" class="muted" style="text-align:center">ارزشیابی‌ای ثبت نشده است.</td></tr><% } %>
<% evals.forEach(function(e){ %><tr><td><%= d(e.eval_date) %></td><td><%= fa(e.term) %></td><% CR.forEach(function(c){ %><td class="num"><%= e.sc[c.key] ? fa(e.sc[c.key]) : '—' %></td><% }) %><td class="num"><b><%= fa(Number(e.total)) %></b></td><td><%= e.comment || '' %></td><td><%= e.evaluator || '—' %></td>
<td><% if (user.role === 'admin') { %><form method="post" action="<%= u('/hr/evaluations/' + e.id + '/delete') %>" data-confirm="حذف شود؟"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm ghost" style="color:var(--red)"><%- icon('trash-2', 15) %></button></form><% } %></td></tr><% }) %></tbody></table></div></div>
