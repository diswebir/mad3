<div class="page-head"><div><h1><%- icon('user-cog', 24) %> منابع انسانی معلمان</h1><div class="muted">موظفی، مرخصی و ارزشیابی</div></div><div class="actions"><a class="btn primary" href="<%= u('/hr/evaluations/new') %>"><%- icon('clipboard-check', 16) %> ارزشیابی جدید</a><a class="btn" href="<%= u('/hr/leaves/new') %>"><%- icon('calendar-x', 16) %> ثبت مرخصی</a></div></div>
<%- include('_nav', { active: 'index' }) %>
<% if (pending) { %><div class="alert warn"><%- icon('bell-ring', 16) %> <%= fa(pending) %> درخواست مرخصی در انتظار بررسی است. <a href="<%= u('/hr/leaves?status=pending') %>">بررسی</a></div><% } %>
<% if (onLeave.length) { %><div class="card"><h3>امروز در مرخصی</h3><% onLeave.forEach(function(l){ %><span class="badge amber" style="margin:.15rem"><%= l.full_name %> — تا <%= d(l.end_date) %></span><% }) %></div><% } %>
<div class="card flush"><div class="table-wrap"><table class="t"><thead><tr><th>معلم</th><th>تخصص</th><th>ساعت تدریس</th><th>موظفی</th><th>مرخصی استحقاقی (مانده)</th><th>مرخصی دیگر</th><th>جانشینی</th><th>آخرین ارزشیابی</th><th></th></tr></thead><tbody>
<% if (!rows.length) { %><tr><td colspan="9" class="muted" style="text-align:center;padding:2rem">معلمی ثبت نشده است.</td></tr><% } %>
<% rows.forEach(function(r){ %><tr><td><a href="<%= u('/hr/teacher/' + r.id) %>"><%= r.full_name %></a><% if (r.status === 'leave') { %> <%- pill('مرخصی', 'amber') %><% } %></td><td><%= r.specialty || '—' %></td><td class="num"><%= fa(r.hours) %></td>
<td><% if (r.load.state === 'none') { %><span class="muted">تعیین نشده</span><% } else { %><%- pill(fa(r.weekly_load) + (r.load.state === 'over' ? ' (+' + fa(r.load.diff) + ')' : r.load.state === 'under' ? ' (−' + fa(-r.load.diff) + ')' : ''), r.load.state === 'over' ? 'red' : r.load.state === 'under' ? 'amber' : 'green') %><% } %></td>
<td class="num"><%= fa(r.leave.casual) %> / <%= fa(r.leave.quota) %> <span class="muted">(<%= fa(r.leave.left) %>)</span></td><td class="num"><%= fa(r.leave.other) %></td><td class="num"><%= fa(r.subs) %></td><td><%= r.lastEval ? fa(Number(r.lastEval.total)) + ' از ۲۰' : '—' %></td><td><a class="btn sm ghost" href="<%= u('/hr/evaluations/new?teacher_id=' + r.id) %>">ارزشیابی</a></td></tr><% }) %>
</tbody></table></div></div>
