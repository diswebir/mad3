<div class="card"><h3><%- icon('baby', 18) %> حساب‌های اولیا (پورتال والدین)</h3>
<% if (!parentAccounts.length) { %><p class="muted">هنوز حساب اولیایی برای این دانش‌آموز ساخته نشده است.</p><% } else { %>
<div class="table-wrap"><table class="t"><thead><tr><th>نسبت</th><th>نام</th><th>نام کاربری</th><th>وضعیت</th><th></th></tr></thead><tbody><% parentAccounts.forEach(function(p){ %><tr><td><%= ({father:'پدر',mother:'مادر',guardian:'سرپرست'})[p.relation] || p.relation %></td><td><%= p.full_name %></td><td class="ltr"><%= p.username %></td><td><%- p.active ? pill('فعال','green') : pill('غیرفعال','red') %></td>
<td class="actions"><form method="post" action="<%= u('/parents/' + p.id + '/unlink/' + s.id) %>" style="display:inline" data-confirm="اتصال این حساب به دانش‌آموز حذف شود؟"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm ghost" title="قطع اتصال"><%- icon('x', 15) %></button></form></td></tr><% }) %></tbody></table></div><% } %>
<form method="post" action="<%= u('/parents/create') %>" style="display:flex;gap:.5rem;flex-wrap:wrap;align-items:center;margin-top:.6rem"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="student_id" value="<%= s.id %>">
<select name="relation" style="width:auto"><option value="father">پدر</option><option value="mother">مادر</option><option value="guardian">سرپرست</option></select><button class="btn primary sm"><%- icon('user-plus', 15) %> ساخت/اتصال حساب (با شماره موبایل اولیا)</button></form></div>
