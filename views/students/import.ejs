<div class="page-head"><div><div class="crumbs"><a href="<%= u('/students') %>">دانش‌آموزان</a> / ورود گروهی</div><h1><%- icon('upload', 24) %> ورود گروهی دانش‌آموزان</h1></div><div class="actions"><a class="btn" href="<%= u('/students/import/template.csv') %>"><%- icon('download', 16) %> دانلود نمونه فایل</a></div></div>
<% if (result) { %>
<div class="alert <%= result.errors.length ? 'warn' : 'success' %>"><%- icon('info', 18) %><div><%= fa(result.ok) %> دانش‌آموز ثبت شد و <%= fa(result.errors.length) %> ردیف خطا داشت.</div></div>
<% if (result.errors.length) { %><div class="card"><h3>خطاها</h3><ul><% result.errors.forEach(function(e){ %><li><%= e %></li><% }) %></ul></div><% } %>
<% if (result.creds.length) { %><div class="card flush"><div class="card-title">اطلاعات ورود دانش‌آموزان (فقط همین یک‌بار نمایش داده می‌شود؛ چاپ یا ذخیره کنید)<button class="btn sm" style="margin-right:auto" data-print>چاپ</button></div><table class="t"><thead><tr><th>نام کاربری</th><th>نام</th><th>رمز اولیه</th></tr></thead><tbody><% result.creds.forEach(function(c){ %><tr><td class="ltr"><%= c[0] %></td><td><%= c[1] %></td><td class="ltr"><%= c[2] %></td></tr><% }) %></tbody></table></div><% } %>
<% } %>
<form class="card" method="post" enctype="multipart/form-data" action="<%= u('/students/import') %>?_csrf=<%= csrf %>">
  <p>فایل CSV با ستون‌های زیر (به همین ترتیب) بارگذاری کنید؛ ردیف اول سرستون است:</p>
  <p class="small muted"><%= cols.map(function(c){ return c[1]; }).join(' | ') %></p>
  <div class="field"><label>فایل CSV</label><input type="file" name="file" accept=".csv,text/csv" required></div>
  <div class="form-actions" style="border:0"><button class="btn primary"><%- icon('upload', 16) %> شروع ورود اطلاعات</button></div>
</form>
