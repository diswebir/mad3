<div class="page-head"><div><h1><%- icon('smartphone', 24) %> گزارش پیامک‌ها</h1><div class="muted small">وضعیت سرویس: <%- cfg.enabled ? pill('فعال', 'green') : pill('غیرفعال', 'gray') %> <%- pill(cfg.provider === 'ippanel' ? 'ippanel' : 'آزمایشی', 'blue') %></div></div>
<div class="actions"><a class="btn" href="<%= u('/messages') %>"><%- icon('send', 16) %> پیام گروهی</a><a class="btn" href="<%= u('/settings') %>"><%- icon('settings', 16) %> تنظیمات پیامک</a></div></div>
<div class="grid g4"><% [['sent','ارسال‌شده','green'],['queued','در صف','amber'],['failed','ناموفق','red'],['simulated','آزمایشی','blue']].forEach(function(x){ %><div class="card stat <%= x[2] %>" style="margin:0"><div><div class="v"><%= fa(stats[x[0]] || 0) %></div><div class="l"><%= x[1] %></div></div></div><% }) %></div>
<div class="card" style="margin-top:1rem"><h3>پیامک آزمایشی</h3><form method="post" action="<%= u('/sms/test') %>" class="toolbar"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="text" class="ltr" name="to" placeholder="09123456789" required><button class="btn primary"><%- icon('send', 15) %> ارسال آزمایشی</button></form></div>
<div class="card flush"><form class="toolbar" method="get"><input type="text" name="q" value="<%= q %>" placeholder="شماره یا متن پیام">
<select name="status" data-autosubmit><option value="">همه وضعیت‌ها</option><% [['sent','ارسال‌شده'],['queued','در صف'],['failed','ناموفق'],['simulated','آزمایشی']].forEach(function(x){ %><option value="<%= x[0] %>" <%= status === x[0] ? 'selected' : '' %>><%= x[1] %></option><% }) %></select>
<select name="event" data-autosubmit><option value="">همه رویدادها</option><% [['group','پیام گروهی'],['absence','غیبت'],['late','تأخیر'],['exit','خروج'],['grades','نمره'],['credentials','حساب اولیا'],['debt','یادآوری بدهی'],['birthday','تولد'],['test','آزمایشی'],['manual','دستی']].forEach(function(x){ %><option value="<%= x[0] %>" <%= event === x[0] ? 'selected' : '' %>><%= x[1] %></option><% }) %></select><button class="btn"><%- icon('filter', 15) %> اعمال</button></form>
<% if (stats.failed) { %><form method="post" action="<%= u('/sms/retry') %>" style="padding:0 1rem .6rem"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn danger sm">ارسال مجدد همه‌ی ناموفق‌ها (<%= fa(stats.failed) %>)</button></form><% } %>
<div class="table-wrap"><table class="t"><thead><tr><th>زمان</th><th>شماره</th><th>دانش‌آموز</th><th>رویداد</th><th>متن</th><th>وضعیت</th></tr></thead><tbody>
<% if (!rows.length) { %><tr><td colspan="6" class="muted" style="text-align:center">پیامکی ثبت نشده است.</td></tr><% } %>
<% rows.forEach(function(r){ %><tr><td class="muted small"><%= dt(r.created_at) %></td><td class="ltr num"><%= display(r.to_number.replace('+98','0')) || r.to_number.replace('+98','0') %></td><td><%= r.first_name ? r.first_name + ' ' + r.last_name : '—' %></td><td><%= r.event %></td><td style="max-width:320px;white-space:pre-wrap"><%= r.message %></td>
<td><%- pill(({sent:'ارسال شد',queued:'در صف',failed:'ناموفق',simulated:'آزمایشی'})[r.status] || r.status, ({sent:'green',queued:'amber',failed:'red',simulated:'blue'})[r.status]) %><% if (r.error) { %><div class="muted small"><%= r.error %></div><% } %></td></tr><% }) %></tbody></table></div>
<%- include('../partials/pager', { page: page, pages: pages }) %></div>
