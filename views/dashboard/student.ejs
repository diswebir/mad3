<div class="page-head"><div><div class="crumbs"><%= ld(today) %><% if (!isSchoolDay) { %> — امروز تعطیل است<% } %></div><h1>سلام <%= user.full_name %> 👋</h1><% if (typeof klass !== 'undefined' && klass) { %><div class="muted">کلاس <b><%= klass.name %></b><% if (klass.homeroom_name) { %> — معلم راهنما: <%= klass.homeroom_name %><% } %> — شماره دانش‌آموزی: <span class="num"><%= fa(student.student_code) %></span></div><% } %></div>
  <div class="actions"><% if (enabled('tickets')) { %><a class="btn primary" href="<%= u('/tickets/new') %>"><%- icon('send', 16) %> ارسال تیکت</a><% } %><a class="btn" href="<%= u('/students/me') %>"><%- icon('id-card', 16) %> پرونده من</a></div></div>
<div class="grid g4" style="margin-bottom:1.1rem">
  <% if (typeof att !== 'undefined') { %>
  <a class="card stat green link" style="margin:0" href="<%= u('/attendance/my') %>"><div class="ico"><%- icon('calendar-check', 24) %></div><div><div class="v"><%= att.rate === null ? '—' : fa(att.rate) + '٪' %></div><div class="l">درصد حضور</div></div></a>
  <a class="card stat red link" style="margin:0" href="<%= u('/attendance/my') %>"><div class="ico"><%- icon('circle-x', 24) %></div><div><div class="v"><%= fa(att.absent || 0) %></div><div class="l">روز غیبت</div></div></a>
  <% } %>
  <% if (typeof debt !== 'undefined') { %><a class="card stat amber link" style="margin:0" href="<%= u('/finance') %>"><div class="ico"><%- icon('wallet', 24) %></div><div><div class="v" style="font-size:1.15rem"><%= money(debt) %></div><div class="l">مانده بدهی (<%= S('currency_label') %>)</div></div></a><% } %>
  <% if (typeof tickets !== 'undefined') { %><a class="card stat link" style="margin:0" href="<%= u('/tickets') %>"><div class="ico"><%- icon('life-buoy', 24) %></div><div><div class="v"><%= fa(tickets.length) %></div><div class="l">تیکت باز</div></div></a><% } %>
</div>
<div class="grid g-side"><div>
  <%- include('../partials/todo-card') %>
  <% if (typeof schedule !== 'undefined') { %>
  <div class="card"><h3><%- icon('clock', 18) %> برنامه امروز</h3>
    <% if (!schedule.length) { %><div class="muted">برنامه‌ای برای امروز ثبت نشده است.</div><% } else { %>
    <ul class="list"><% schedule.forEach(function(s){ var p = periods.find(function(x){ return x.n === s.period; }); %><li><span class="badge blue nowrap">زنگ <%= fa(s.period) %></span><div><b><%= s.subject_name %></b><div class="muted small"><%= s.teacher_name || '' %> <%= p ? ' — ' + fa(p.start) + ' تا ' + fa(p.end) : '' %></div></div></li><% }) %></ul><% } %>
  </div>
  <% } %>
  <% if (typeof homework !== 'undefined' && homework.length) { %>
  <div class="card flush"><div class="card-title"><%- icon('notebook-pen', 18) %> تکالیف <a class="btn sm ghost" style="margin-right:auto" href="<%= u('/homework') %>">همه</a></div>
    <div class="table-wrap"><table class="t"><tbody><% homework.forEach(function(h){ %><tr><td><a href="<%= u('/homework/' + h.id) %>"><%= h.title %></a><div class="muted small"><%= h.subject_name %></div></td><td><%= h.due_date ? 'مهلت: ' + d(h.due_date) : '' %></td><td><%- h.sub_id ? pill(h.score !== null ? 'نمره: ' + fa(h.score) : 'تحویل شد', 'green') : (h.due_date && h.due_date < today ? pill('عدم تحویل', 'red') : pill('تحویل‌نشده', 'amber')) %></td></tr><% }) %></tbody></table></div></div>
  <% } %>
  <% if (typeof scores !== 'undefined' && scores.length) { %>
  <div class="card flush"><div class="card-title"><%- icon('award', 18) %> آخرین نمرات <a class="btn sm ghost" style="margin-right:auto" href="<%= u('/grades/my') %>">کارنامه</a></div>
    <div class="table-wrap"><table class="t"><tbody><% scores.forEach(function(s){ %><tr><td><%= s.subject_name %></td><td><%= s.title %></td><td class="num"><b><%= fa(s.score) %></b> / <%= fa(s.max_score) %></td><td class="muted small"><%= d(s.date) %></td></tr><% }) %></tbody></table></div></div>
  <% } %>
</div><div>
  <% if (typeof recentAbsences !== 'undefined' && recentAbsences.length && enabled('tickets')) { %><div class="alert warn"><%- icon('triangle-alert', 18) %><div>غیبت‌های اخیر: <%= recentAbsences.map(function(a){ return d(a.date); }).join('، ') %>. برای توجیه غیبت <a href="<%= u('/tickets/new?category=absence&date=' + recentAbsences[0].date) %>">تیکت ارسال کنید</a>.</div></div><% } %>
  <% if (typeof loans !== 'undefined' && loans.length) { %><div class="card"><h3><%- icon('library-big', 18) %> کتاب‌های امانتی</h3><ul class="list"><% loans.forEach(function(l){ %><li><div><b><a href="<%= u('/library/loans') %>"><%= l.title %></a></b><div class="muted small">موعد بازگشت: <%= d(l.due_date) %></div></div></li><% }) %></ul></div><% } %>
  <%- include('../partials/common-widgets') %>
</div></div>
