<div class="page-head"><div><div class="crumbs"><%= ld(today) %><% if (!isSchoolDay) { %> — امروز تعطیل است<% } %></div><h1>سلام <%= user.full_name %> 👋</h1></div>
  <div class="actions"><% if (enabled('attendance')) { %><a class="btn primary" href="<%= u('/attendance') %>"><%- icon('calendar-check', 16) %> حضور و غیاب</a><% } %><% if (enabled('tickets')) { %><a class="btn" href="<%= u('/tickets/new') %>"><%- icon('send', 16) %> تیکت جدید</a><% } %></div></div>
<% if (typeof pendingAttendance !== 'undefined' && pendingAttendance.length) { %><div class="alert warn"><%- icon('triangle-alert', 18) %><div>حضور و غیاب امروز برای کلاس <%= pendingAttendance.map(function(c){ return c.name; }).join('، ') %> هنوز ثبت نشده است. <a href="<%= u('/attendance?class_id=' + pendingAttendance[0].id) %>">ثبت کنید</a></div></div><% } %>
<div class="grid g4" style="margin-bottom:1.1rem">
  <a class="card stat link" style="margin:0" href="<%= u('/classes') %>"><div class="ico"><%- icon('school', 24) %></div><div><div class="v"><%= fa(classes.length) %></div><div class="l">کلاس من</div></div></a>
  <a class="card stat green link" style="margin:0" href="<%= u('/students') %>"><div class="ico"><%- icon('graduation-cap', 24) %></div><div><div class="v"><%= fa(classes.reduce(function(a, c){ return a + Number(c.student_count); }, 0)) %></div><div class="l">دانش‌آموز</div></div></a>
  <% if (typeof ticketCount !== 'undefined') { %><a class="card stat red link" style="margin:0" href="<%= u('/tickets') %>"><div class="ico"><%- icon('life-buoy', 24) %></div><div><div class="v"><%= fa(ticketCount) %></div><div class="l">تیکت منتظر پاسخ</div></div></a><% } %>
  <% if (typeof toGrade !== 'undefined') { %><a class="card stat amber link" style="margin:0" href="<%= u('/homework') %>"><div class="ico"><%- icon('notebook-pen', 24) %></div><div><div class="v"><%= fa(toGrade) %></div><div class="l">تکلیف بدون نمره</div></div></a><% } %>
</div>
<div class="grid g-side"><div>
  <%- include('../partials/todo-card') %>
  <% if (typeof schedule !== 'undefined') { %>
  <div class="card"><h3><%- icon('clock', 18) %> برنامه امروز من</h3>
    <% if (!schedule.length) { %><div class="muted">امروز کلاسی ندارید.</div><% } else { %>
    <ul class="list"><% schedule.forEach(function(s){ var p = periods.find(function(x){ return x.n === s.period; }); %><li><span class="badge blue nowrap">زنگ <%= fa(s.period) %></span><div><b><%= s.subject_name %></b> — <%= s.class_name %><div class="muted small"><%= p ? fa(p.start) + ' تا ' + fa(p.end) : '' %></div></div><% if (enabled('attendance')) { %><a class="btn sm ghost" style="margin-right:auto" href="<%= u('/attendance?class_id=' + s.classroom_id) %>">حضور و غیاب</a><% } %></li><% }) %></ul><% } %>
  </div>
  <% } %>
  <div class="card flush"><div class="card-title"><%- icon('school', 18) %> کلاس‌های من</div>
    <div class="table-wrap"><table class="t"><thead><tr><th>کلاس</th><th>دانش‌آموز</th><th>نقش</th><th></th></tr></thead><tbody>
    <% classes.forEach(function(c){ %><tr><td><a href="<%= u('/classes/' + c.id) %>"><b><%= c.name %></b></a></td><td><%= fa(c.student_count) %></td><td><%- homeroomIds && homeroomIds.includes(c.id) ? pill('معلم راهنما', 'green') : pill('مدرس', 'blue') %></td><td class="actions"><a class="btn sm ghost" href="<%= u('/classes/' + c.id) %>">مشاهده</a></td></tr><% }) %>
    <% if (!classes.length) { %><tr><td colspan="4" class="empty">هنوز کلاسی به شما اختصاص داده نشده است.</td></tr><% } %>
    </tbody></table></div></div>
  <% if (typeof tickets !== 'undefined' && tickets.length) { %>
  <div class="card flush"><div class="card-title"><%- icon('life-buoy', 18) %> تیکت‌های منتظر پاسخ</div>
    <div class="table-wrap"><table class="t"><tbody><% tickets.forEach(function(t){ %><tr><td><a href="<%= u('/tickets/' + t.id) %>"><%= t.subject %></a></td><td><%= t.creator %></td><td class="muted small"><%= dt(t.created_at) %></td></tr><% }) %></tbody></table></div></div>
  <% } %>
</div><div>
  <% if (typeof birthdays !== 'undefined' && birthdays.length) { %><div class="card"><h3><%- icon('cake', 18) %> تولد امروز 🎂</h3><ul class="list"><% birthdays.forEach(function(b){ %><li><div><b><a href="<%= u('/students/' + b.id) %>"><%= b.first_name %> <%= b.last_name %></a></b><div class="muted small"><%= b.class_name %></div></div></li><% }) %></ul></div><% } %>
  <%- include('../partials/common-widgets') %>
</div></div>
