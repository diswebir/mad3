<div class="page-head"><div><h1><%- icon('chart-bar', 24) %> گزارش‌ها و آمار</h1></div><div class="actions"><a class="btn" href="<%= u('/reports/students.csv') %>"><%- icon('download', 16) %> CSV کلاس‌ها</a><button class="btn" data-print><%- icon('printer', 16) %> چاپ</button></div></div>
<%- include('../analytics/_nav', { active: 'overview' }) %>
<div class="grid g2">
<div class="card"><h3><%- icon('school', 18) %> دانش‌آموزان به تفکیک کلاس</h3><div class="bars"><% classes.forEach(function(c){ var pct = c.capacity ? Math.round(c.cnt * 100 / c.capacity) : 0; %><div class="row"><span><%= c.name %></span><div class="progress <%= pct >= 100 ? 'red' : pct >= 85 ? 'amber' : '' %>"><i style="width:<%= Math.min(100, pct) %>%"></i></div><span class="num"><%= fa(c.cnt) %>/<%= fa(c.capacity) %></span></div><% }) %></div></div>
<div class="card"><h3><%- icon('chart-pie', 18) %> وضعیت و جنسیت</h3><dl class="kv" style="grid-template-columns:130px 1fr"><dt>پسر</dt><dd><%= fa(gender.male || 0) %></dd><dt>دختر</dt><dd><%= fa(gender.female || 0) %></dd><% Object.keys(status).forEach(function(s){ %><dt><%= L.studentStatus[s] || s %></dt><dd><%= fa(status[s]) %></dd><% }) %></dl></div>
<% if (typeof att !== 'undefined') { %><div class="card"><h3><%- icon('calendar-check', 18) %> درصد حضور کلاس‌ها — <%= monthLabel %></h3><% if (!att.length) { %><div class="muted">داده‌ای نیست.</div><% } %><div class="bars"><% att.forEach(function(a){ var r = a.total ? Math.round(Number(a.present) * 100 / a.total) : 0; %><div class="row"><span><%= a.name %></span><div class="progress <%= r >= 92 ? 'green' : r >= 85 ? 'amber' : 'red' %>"><i style="width:<%= r %>%"></i></div><span class="num"><%= fa(r) %>٪</span></div><% }) %></div></div>
<div class="card flush"><div class="card-title"><%- icon('user-round', 18) %> بیشترین غیبت (کل سال)</div><table class="t"><tbody><% topAbsent.forEach(function(s){ %><tr><td><a href="<%= u('/students/' + s.id + '?tab=attendance') %>"><%= s.first_name %> <%= s.last_name %></a></td><td><%= s.cname %></td><td class="num"><span class="badge <%= s.n >= threshold ? 'red' : 'amber' %>"><%= fa(s.n) %> روز</span></td></tr><% }) %><% if (!topAbsent.length) { %><tr><td class="empty">غیبتی ثبت نشده است.</td></tr><% } %></tbody></table></div><% } %>
<% if (typeof grades !== 'undefined') { %><div class="card"><h3><%- icon('award', 18) %> میانگین نمرات کلاس‌ها</h3><div class="bars"><% grades.forEach(function(g){ %><div class="row"><span><%= g.name %></span><div class="progress"><i style="width:<%= Math.min(100, Math.round(g.avg * 100 / S('grade_scale'))) %>%"></i></div><span class="num"><%= fa(g.avg) %></span></div><% }) %><% if (!grades.length) { %><div class="muted">نمره‌ای ثبت نشده است.</div><% } %></div></div>
<div class="card flush"><div class="card-title"><%- icon('trophy', 18) %> دانش‌آموزان برتر مدرسه</div><table class="t"><tbody><% top.forEach(function(s, i){ %><tr><td><span class="badge amber"><%= fa(i + 1) %></span></td><td><a href="<%= u('/grades/report-card/' + s.id) %>"><%= s.name %></a></td><td><%= s.cname %></td><td class="num"><b><%= fa(s.overall) %></b></td></tr><% }) %><% if (!top.length) { %><tr><td class="empty">داده‌ای نیست.</td></tr><% } %></tbody></table></div><% } %>
<% if (typeof tickets !== 'undefined') { %><div class="card"><h3><%- icon('life-buoy', 18) %> آمار تیکت‌ها</h3><dl class="kv" style="grid-template-columns:130px 1fr"><% Object.keys(L.ticketStatus).forEach(function(s){ %><dt><%= L.ticketStatus[s] %></dt><dd><%= fa(tickets.status[s] || 0) %></dd><% }) %><dt>میانگین رضایت</dt><dd><%= tickets.rating ? fa(Math.round(tickets.rating * 10) / 10) + ' از ۵' : '—' %></dd></dl><h4 style="margin-top:.8rem">بر اساس دسته</h4><div style="display:flex;gap:.4rem;flex-wrap:wrap"><% tickets.category.forEach(function(c){ %><span class="badge blue"><%= L.ticketCategory[c.category] || c.category %>: <%= fa(c.c) %></span><% }) %></div></div><% } %>
<% if (typeof fin !== 'undefined') { %><div class="card"><h3><%- icon('wallet', 18) %> وضعیت مالی کلاس‌ها (<%= S('currency_label') %>)</h3><div class="table-wrap"><table class="t"><thead><tr><th>کلاس</th><th>صورت‌حساب</th><th>پرداخت‌شده</th><th>مانده</th></tr></thead><tbody><% fin.forEach(function(f){ %><tr><td><%= f.name %></td><td class="num"><%= money(f.billed) %></td><td class="num" style="color:var(--green)"><%= money(f.paid) %></td><td class="num" style="color:var(--red)"><%= money(Math.max(0, f.billed - f.paid)) %></td></tr><% }) %></tbody></table></div></div><% } %>
<div class="card"><h3><%- icon('briefcase', 18) %> حجم کار معلمان (ساعت هفتگی)</h3><div class="bars"><% workload.forEach(function(w){ %><div class="row"><span><%= w.full_name %></span><div class="progress <%= w.hours > 24 ? 'red' : '' %>"><i style="width:<%= Math.min(100, Math.round(w.hours * 100 / 24)) %>%"></i></div><span class="num"><%= fa(w.hours) %></span></div><% }) %></div></div>
</div>
