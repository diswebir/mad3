<div class="page-head"><div><h1><%- icon('calendar-days', 24) %> تقویم — <%= MONTHS[jm - 1] %> <%= fa(jy) %></h1></div><div class="actions"><a class="btn" href="<%= prev %>"><%- icon('chevron-right', 16) %> ماه قبل</a><a class="btn" href="<%= u('/calendar') %>">امروز</a><a class="btn" href="<%= next %>">ماه بعد <%- icon('chevron-left', 16) %></a><% if (isManager) { %><a class="btn primary" href="<%= u('/events/new') %>"><%- icon('plus', 16) %> رویداد جدید</a><% } %></div></div>
<div class="cal"><% WEEKDAYS.forEach(function(w){ %><div class="h"><%= w %></div><% }) %>
<% cells.forEach(function(c){ if (!c) { %><div class="off"></div><% } else { %><div class="<%= c.today ? 'today' : '' %> <%= c.off ? 'off' : '' %>"><div class="d"><%= fa(c.d) %></div><% c.items.slice(0, 4).forEach(function(i){ %><span class="ev <%= i.c %>" title="<%= i.t %>"><%= i.t %></span><% }) %><% if (c.items.length > 4) { %><span class="muted small">+<%= fa(c.items.length - 4) %> مورد</span><% } %></div><% } }) %></div>
<div style="display:flex;gap:1rem;margin-top:.8rem" class="small"><span class="badge blue">رویداد</span><span class="badge amber">امتحان</span><span class="badge red">تعطیلی</span><span class="badge green">تولد</span></div>
