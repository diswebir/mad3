<!doctype html>
<html lang="fa" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title ? title + ' | ' : '' %><%= S('school_name') %></title>
<meta name="theme-color" content="<%= S('primary_color') %>">
<link rel="preload" href="<%= base %>/assets/fonts/Vazirmatn-Variable.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="<%= asset('css/app.css') %>">
<style>:root{--primary:<%= /^#[0-9a-fA-F]{6}$/.test(S('primary_color')) ? S('primary_color') : '#2563eb' %>}</style>
<script src="<%= asset('js/theme.js') %>"></script>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%232563eb' stroke-width='2'%3E%3Cpath d='m4 10 8-5 8 5-8 5z'/%3E%3Cpath d='M18 12v4c0 1-2.5 2-6 2s-6-1-6-2v-4'/%3E%3C/svg%3E">
</head>
<body>
<div class="app">
<aside class="sidebar" id="sidebar">
  <a class="brand" href="<%= u('/') %>" style="text-decoration:none">
    <span class="logo"><% if (S('logo')) { %><img src="<%= fileUrl('branding', S('logo')) %>" alt=""><% } else { %><%- icon('school', 22) %><% } %></span>
    <span><%= S('school_name') %><small>سامانه مدیریت مدرسه</small></span>
  </a>
  <nav class="nav" id="nav" aria-label="منوی اصلی">
    <% var NAV_ICONS = { main: 'layout-dashboard', edu: 'graduation-cap', comm: 'message-square', services: 'briefcase', system: 'settings' };
       var topItems = []; var secs = (nav || []).map(function(sec){ var rest = sec.items.filter(function(it){ if (it.href === '/') { topItems.push(it); return false; } return true; }); return { key: sec.key, title: sec.title, items: rest }; }).filter(function(sec){ return sec.items.length; });
       var activeSec = ''; secs.forEach(function(sec){ if (sec.items.some(function(it){ return activeHref === it.href; })) activeSec = sec.key; });
       if (!activeSec && secs.length) activeSec = ''; %>
    <% topItems.forEach(function(it){ %><a href="<%= u(it.href) %>" class="nav-top <%= activeHref === it.href ? 'active' : '' %>"><%- icon(it.icon, 18) %><span><%= it.label %></span></a><% }) %>
    <% secs.forEach(function(sec){ var open = sec.key === activeSec; var bsum = sec.items.reduce(function(a, it){ return a + (it.badgeCount || 0); }, 0); %>
    <div class="nav-group<%= open ? ' open' : '' %><%= sec.items.some(function(it){ return activeHref === it.href; }) ? ' has-active' : '' %>" data-key="<%= sec.key %>">
      <button type="button" class="nav-head" aria-expanded="<%= open ? 'true' : 'false' %>" aria-controls="ng-<%= sec.key %>">
        <span class="nh-ic"><%- icon(NAV_ICONS[sec.key] || 'layout-grid', 18) %></span><span class="nh-t"><%= sec.title %></span>
        <% if (bsum) { %><span class="badge-n"><%= fa(bsum) %></span><% } %><span class="nh-n"><%= fa(sec.items.length) %></span><span class="nh-chev"><%- icon('chevron-down', 16) %></span>
      </button>
      <div class="nav-body" id="ng-<%= sec.key %>"><div class="nav-inner">
        <% sec.items.forEach(function(it){ %><a href="<%= u(it.href) %>" class="<%= activeHref === it.href ? 'active' : '' %>"><%- icon(it.icon, 18) %><span><%= it.label %></span><% if (it.badgeCount) { %><span class="badge-n"><%= fa(it.badgeCount) %></span><% } %></a><% }) %>
      </div></div>
    </div>
    <% }) %>
    <noscript><style>.nav-body{grid-template-rows:1fr!important}</style></noscript>
  </nav>
</aside>
<div class="main">
  <header class="topbar">
    <button class="icon-btn" id="menu-btn" aria-label="منو"><%- icon('menu', 22) %></button>
    <form class="search" action="<%= u('/search') %>" method="get" role="search"><%- icon('search', 17) %><input type="search" name="q" placeholder="جستجو در سامانه..." value="<%= (typeof gq !== 'undefined') ? gq : '' %>" autocomplete="off"></form>
    <span class="grow"></span>
    <button class="icon-btn" id="theme-toggle" type="button" aria-label="حالت تیره"><%- icon('moon', 20) %></button>
    <a class="icon-btn" href="<%= u('/notifications') %>" aria-label="اعلان‌ها"><%- icon('bell', 20) %><% if (badgeCounts && badgeCounts.notifications) { %><span class="dot"><%= fa(badgeCounts.notifications > 99 ? '99+' : badgeCounts.notifications) %></span><% } %></a>
    <div class="user-menu">
      <button type="button" data-dropdown><span class="avatar"><% if (user.avatar) { %><img src="<%= fileUrl('photos', user.avatar) %>" alt=""><% } else { %><%= initials(user.full_name) %><% } %></span><span class="small"><%= user.full_name %><br><span class="muted"><%= L.roles[user.realRole || user.role] %><% if (user.title) { %> — <%= user.title %><% } %></span></span></button>
      <div class="dropdown">
        <a href="<%= u('/profile') %>"><%- icon('user-round', 17) %> پروفایل من</a>
        <a href="<%= u('/profile/password') %>"><%- icon('key-round', 17) %> تغییر رمز عبور</a>
        <form method="post" action="<%= u('/logout') %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button type="submit"><%- icon('log-out', 17) %> خروج</button></form>
      </div>
    </div>
  </header>
  <main class="content">
    <% if (user.realRole === 'parent' && user.children && user.children.length) { %><div class="alert info" style="align-items:center;gap:.8rem;flex-wrap:wrap"><%- icon('baby', 18) %><div>در حال مشاهده‌ی پرونده‌ی فرزند: <b><%= user.student ? user.student.first_name + ' ' + user.student.last_name : '—' %></b></div><% if (user.children.length > 1) { %><form method="post" action="<%= u('/parent/switch') %>" style="display:flex;gap:.4rem;margin-inline-start:auto"><input type="hidden" name="_csrf" value="<%= csrf %>"><select name="student_id" data-autosubmit><% user.children.forEach(function(c){ %><option value="<%= c.id %>" <%= user.student && user.student.id === c.id ? 'selected' : '' %>><%= c.first_name %> <%= c.last_name %></option><% }) %></select></form><% } %></div><% } %>
    <% (flash || []).forEach(function(f){ %><div class="alert flash <%= f.type %>"><%- icon(f.type === 'success' ? 'circle-check' : f.type === 'error' ? 'circle-x' : 'info', 18) %><div><%= f.msg %></div></div><% }) %>
    <%- body %>
  </main>
  <footer class="footer"><%= S('school_name') %> — سامانه مدیریت مدرسه <span class="muted small ltr">v<%= APP_VERSION %></span></footer>
</div>
</div>
<script src="<%= asset('js/jalaali.js') %>" defer></script>
<script src="<%= asset('js/app.js') %>" defer></script>
</body>
</html>
