<div class="page-head"><div><h1><%- icon('users', 24) %> کاربران سامانه</h1><div class="muted small"><%= fa(total) %> کاربر</div></div><div class="actions"><a class="btn primary" href="<%= u('/users/new') %>"><%- icon('plus', 16) %> مدیر/معاون جدید</a></div></div>
<div class="card flush">
<form class="toolbar" method="get"><input type="text" name="q" value="<%= q %>" placeholder="جستجوی نام، نام کاربری، تلفن">
<select name="role" data-autosubmit><option value="">همه نقش‌ها</option><% Object.keys(L.roles).forEach(function(r){ if (r === 'superadmin' && !user.isSuper) return; %><option value="<%= r %>" <%= role === r ? 'selected' : '' %>><%= L.roles[r] %></option><% }) %></select>
<select name="active" data-autosubmit><option value="">همه وضعیت‌ها</option><option value="1" <%= active === '1' ? 'selected' : '' %>>فعال</option><option value="0" <%= active === '0' ? 'selected' : '' %>>غیرفعال</option></select>
<button class="btn"><%- icon('filter', 15) %> اعمال</button></form>
<div class="table-wrap"><table class="t"><thead><tr><th>نام</th><th>نام کاربری</th><th>نقش</th><th>وضعیت</th><th>آخرین ورود</th><th></th></tr></thead><tbody>
<% rows.forEach(function(r){ %><tr><td><b><%= r.full_name %></b></td><td class="ltr"><%= r.username %></td><td><%= L.roles[r.role] %></td><td><%- r.active ? pill('فعال', 'green') : pill('غیرفعال', 'red') %></td><td class="muted small"><%= r.last_login ? dt(r.last_login) : '—' %></td>
<td class="actions">
<% if (['teacher','deputy'].includes(r.role)) { %><a class="btn sm ghost" title="سطح دسترسی" href="<%= u('/access/user/' + r.id) %>"><%- icon('key-round', 15) %></a><% } %>
<a class="btn sm ghost" href="<%= u('/users/' + r.id + '/edit') %>"><%- icon('pencil', 15) %></a>
<form method="post" action="<%= u('/users/' + r.id + '/reset-password') %>" style="display:inline" data-confirm="رمز عبور این کاربر بازنشانی شود؟"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm ghost" title="بازنشانی رمز"><%- icon('key-round', 15) %></button></form>
<% if (r.id !== user.id) { %><form method="post" action="<%= u('/users/' + r.id + '/toggle') %>" style="display:inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm ghost" title="<%= r.active ? 'غیرفعال‌سازی' : 'فعال‌سازی' %>"><%- icon(r.active ? 'lock' : 'check', 15) %></button></form><% } %>
<% if (r.id !== user.id && (r.role === 'admin' || r.role === 'deputy')) { %><form method="post" action="<%= u('/users/' + r.id + '/delete') %>" style="display:inline" data-confirm="حذف این کاربر قطعی است. ادامه می‌دهید؟"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm ghost" style="color:var(--red)"><%- icon('trash-2', 15) %></button></form><% } %></td></tr><% }) %>
</tbody></table></div>
<%- include('../partials/pager', { page: page, pages: pages }) %></div>
