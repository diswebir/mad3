<div class="page-head"><div><h1><%- icon('wallet', 24) %> امور مالی</h1><div class="muted small"><%= fa(total) %> صورت‌حساب — واحد: <%= S('currency_label') %></div></div>
<% if (!isStudent) { %><div class="actions"><a class="btn" href="<%= u('/finance/debtors') %>"><%- icon('triangle-alert', 16) %> بدهکاران</a><a class="btn primary" href="<%= u('/finance/fees/new') %>"><%- icon('plus', 16) %> صورت‌حساب جدید</a></div><% } %></div>
<div class="grid g3" style="margin-bottom:1rem"><div class="card stat" style="margin:0"><div class="ico"><%- icon('receipt', 22) %></div><div><div class="v" style="font-size:1.2rem"><%= money(sum.billed) %></div><div class="l">جمع صورت‌حساب (نتیجه فیلتر)</div></div></div>
<div class="card stat green" style="margin:0"><div class="ico"><%- icon('hand-coins', 22) %></div><div><div class="v" style="font-size:1.2rem"><%= money(sum.paid) %></div><div class="l">پرداخت‌شده</div></div></div>
<div class="card stat red" style="margin:0"><div class="ico"><%- icon('triangle-alert', 22) %></div><div><div class="v" style="font-size:1.2rem"><%= money(Math.max(0, sum.billed - sum.paid)) %></div><div class="l">مانده</div></div></div></div>
<div class="card flush">
<% if (!isStudent) { %><form class="toolbar" method="get"><input type="text" name="q" value="<%= f.q || '' %>" placeholder="نام دانش‌آموز یا عنوان">
<select name="class_id" data-autosubmit><option value="">همه کلاس‌ها</option><% classes.forEach(function(c){ %><option value="<%= c.id %>" <%= String(f.class_id) === String(c.id) ? 'selected' : '' %>><%= c.name %></option><% }) %></select>
<select name="state" data-autosubmit><option value="">همه وضعیت‌ها</option><option value="unpaid" <%= f.state === 'unpaid' ? 'selected' : '' %>>پرداخت‌نشده</option><option value="partial" <%= f.state === 'partial' ? 'selected' : '' %>>بخشی پرداخت‌شده</option><option value="paid" <%= f.state === 'paid' ? 'selected' : '' %>>تسویه</option></select><button class="btn"><%- icon('search', 15) %> جستجو</button></form><% } %>
<% if (!rows.length) { %><div class="empty"><%- icon('wallet', 42) %><div>صورت‌حسابی یافت نشد.</div></div><% } else { %><div class="table-wrap"><table class="t"><thead><tr><% if (!isStudent) { %><th>دانش‌آموز</th><% } %><th>عنوان</th><th>خالص</th><th>پرداختی</th><th>مانده</th><th>سررسید</th><th>وضعیت</th><th></th></tr></thead><tbody>
<% rows.forEach(function(r){ %><tr><% if (!isStudent) { %><td><a href="<%= u('/students/' + r.student_id + '?tab=finance') %>"><%= r.first_name %> <%= r.last_name %></a><div class="muted small"><%= r.class_name || '' %></div></td><% } %><td><%= r.title %><div class="muted small"><%= L.feeCategory[r.category] %></div></td><td class="num"><%= money(r.net) %></td><td class="num" style="color:var(--green)"><%= money(r.paid) %></td><td class="num" style="color:<%= r.remaining ? 'var(--red)' : 'var(--green)' %>"><%= money(r.remaining) %></td><td><%= d(r.due_date) %><% if (r.overdue) { %> <span class="badge red">معوق</span><% } %></td>
<td><%- r.state === 'paid' ? pill('تسویه', 'green') : r.state === 'partial' ? pill('بخشی', 'amber') : pill('پرداخت‌نشده', 'red') %></td><td class="actions"><a class="btn sm ghost" href="<%= u('/finance/fees/' + r.id) %>"><%- icon('eye', 15) %></a></td></tr><% }) %></tbody></table></div><%- include('../partials/pager', { page: page, pages: pages }) %><% } %></div>
