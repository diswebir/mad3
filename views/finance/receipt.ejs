<div class="page-head no-print"><h1>رسید پرداخت</h1><div class="actions"><button class="btn primary" data-print><%- icon('printer', 16) %> چاپ</button><a class="btn" href="<%= u('/finance/fees/' + f.id) %>">بازگشت</a></div></div>
<div class="card" style="max-width:560px;margin:auto"><div style="text-align:center"><h2 style="margin:0"><%= S('school_name') %></h2><div class="muted">رسید پرداخت وجه</div></div><hr style="border:0;border-top:1px dashed var(--border);margin:1rem 0">
<dl class="kv"><dt>شماره رسید</dt><dd><%= fa(p.id) %></dd><dt>دانش‌آموز</dt><dd><%= f.first_name %> <%= f.last_name %> (<%= fa(f.student_code) %>)</dd><dt>بابت</dt><dd><%= f.title %></dd><dt>مبلغ</dt><dd><b><%= money(p.amount) %></b> <%= S('currency_label') %></dd><dt>تاریخ</dt><dd><%= d(p.paid_at) %></dd><dt>روش پرداخت</dt><dd><%= L.payMethod[p.method] %></dd><dt>شماره پیگیری</dt><dd class="ltr"><%= fa(p.reference || '—') %></dd></dl>
<div style="display:flex;justify-content:space-between;margin-top:2.5rem"><span>امضای مسئول مالی</span><span>مهر مدرسه</span></div></div>
