<div class="page-head"><div><div class="crumbs"><a href="<%= u('/finance') %>">امور مالی</a> / پرداخت آنلاین</div><h1><%- icon('credit-card', 24) %> پرداخت‌های آنلاین</h1><div class="sub">تراکنش‌های درگاه اینترنتی؛ هر پرداخت موفق خودکار سند می‌خورد.</div></div></div>
<% if (!ready) { %><div class="alert warn"><%- icon('triangle-alert', 18) %><div>پرداخت آنلاین هم‌اکنون غیرفعال یا ناقص تنظیم شده است. تنظیمات درگاه را سوپر ادمین (تنظیمات ← مالی) انجام می‌دهد.</div></div><% } %>
<% if (provider === 'demo') { %><div class="alert info"><%- icon('info', 18) %><div>درگاه روی حالت <b>آزمایشی</b> است؛ پرداخت‌ها شبیه‌سازی می‌شوند و وجهی دریافت نمی‌شود.</div></div><% } %>
<div class="grid g4" style="margin-bottom:1rem"><div class="card stat" style="margin:0"><div><div class="v"><%= money(total) %></div><div class="l">مجموع پرداخت موفق (<%= S('currency_label') %>)</div></div></div><div class="card stat" style="margin:0"><div><div class="v"><%= fa(count) %></div><div class="l">تعداد پرداخت موفق</div></div></div></div>
<div class="tabs" style="margin-bottom:1rem"><% [['', 'همه'], ['paid', 'موفق'], ['pending', 'نیمه‌کاره'], ['failed', 'ناموفق'], ['cancelled', 'لغوشده']].forEach(function(t){ %><a href="<%= u('/finance/online' + (t[0] ? '?status=' + t[0] : '')) %>" class="<%= st === t[0] ? 'active' : '' %>"><%= t[1] %></a><% }) %></div>
<div class="card flush"><% if (!rows.length) { %><div class="empty"><%- icon('credit-card', 42) %><div>تراکنشی وجود ندارد.</div></div><% } else { %>
<div class="table-wrap"><table class="t"><thead><tr><th>زمان</th><th>دانش‌آموز</th><th>صورت‌حساب</th><th>مبلغ</th><th>وضعیت</th><th>سند / پیگیری</th><th></th></tr></thead><tbody>
<% rows.forEach(function(r){ %><tr><td><%= dt(r.created_at) %></td><td><a href="<%= u('/students/' + r.student_id) %>"><%= r.first_name %> <%= r.last_name %></a></td><td><a href="<%= u('/finance/fees/' + r.fee_id) %>"><%= r.title %></a></td><td><%= money(r.amount) %></td>
<td><%- r.status === 'paid' ? pill('موفق', 'green') : r.status === 'pending' ? pill('نیمه‌کاره', 'amber') : r.status === 'cancelled' ? pill('لغو شد', 'gray') : pill('ناموفق', 'red') %><% if (r.provider === 'demo') { %> <%- pill('آزمایشی', 'blue') %><% } %><% if (r.error) { %><div class="muted small"><%= r.error %></div><% } %></td>
<td class="ltr" style="text-align:right"><%= r.doc_no || '' %> <%= r.ref_id ? '· ' + r.ref_id : '' %></td>
<td><% if (r.status === 'pending') { %><form method="post" action="<%= u('/finance/online/' + r.id + '/check') %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm" type="submit"><%- icon('refresh-cw', 14) %> بررسی وضعیت</button></form><% } %></td></tr><% }) %>
</tbody></table></div><%- include('../partials/pager', { page: page, pages: pages }) %><% } %></div>
