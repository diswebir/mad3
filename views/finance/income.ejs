<div class="page-head"><div><div class="crumbs"><a href="<%= u('/finance') %>">امور مالی</a></div><h1><%- icon('banknote', 24) %> گزارش درآمد — <%= MONTHS[jm - 1] %> <%= fa(jy) %></h1></div>
<div class="actions"><a class="btn" href="?year=<%= jy %>&month=<%= jm %>&format=xlsx"><%- icon('file-down', 16) %> Excel</a><button class="btn" data-print><%- icon('printer', 16) %> چاپ</button></div></div>
<form class="card" method="get" style="display:flex;gap:.8rem;align-items:end"><div class="field"><label>سال</label><input type="number" class="ltr" name="year" value="<%= jy %>" style="width:100px"></div><div class="field"><label>ماه</label><select name="month" data-autosubmit><% MONTHS.forEach(function(m, i){ %><option value="<%= i + 1 %>" <%= jm === i + 1 ? 'selected' : '' %>><%= m %></option><% }) %></select></div><button class="btn primary">نمایش</button></form>
<div class="grid g3"><div class="card stat green" style="margin:0"><div><div class="v" style="font-size:1.3rem"><%= money(d.total) %></div><div class="l">درآمد ماه (<%= S('currency_label') %>)</div></div></div><div class="card stat blue" style="margin:0"><div><div class="v"><%= fa(d.count) %></div><div class="l">تعداد پرداخت</div></div></div><div class="card stat red" style="margin:0"><div><div class="v"><%= fa(d.voided) %></div><div class="l">پرداخت باطل‌شده</div></div></div></div>
<div class="grid g2" style="margin-top:1rem">
<div class="card"><h3>به تفکیک روش پرداخت</h3><% Object.keys(d.byMethod).forEach(function(m){ %><div style="display:flex;justify-content:space-between;padding:.3rem 0;border-bottom:1px solid var(--border)"><span><%= L.payMethod[m] || m %></span><b class="num"><%= money(d.byMethod[m]) %></b></div><% }) %><% if (!Object.keys(d.byMethod).length) { %><div class="muted">پرداختی ثبت نشده است.</div><% } %></div>
<div class="card"><h3>به تفکیک دسته</h3><% Object.keys(d.byCategory).forEach(function(m){ %><div style="display:flex;justify-content:space-between;padding:.3rem 0;border-bottom:1px solid var(--border)"><span><%= L.feeCategory[m] || m %></span><b class="num"><%= money(d.byCategory[m]) %></b></div><% }) %><% if (!Object.keys(d.byCategory).length) { %><div class="muted">—</div><% } %></div></div>
<div class="card"><h3>روند ماهانه‌ی سال <%= fa(jy) %></h3><% var mx = Math.max.apply(null, months.map(function(x){ return x.total; }).concat([1])); %><%- charts.barChart(months.map(function(x){ return { label: MONTHS[x.m - 1], value: x.total / 1000000, color: x.m === jm ? '#16a34a' : '#93c5fd' }; }), { unit: ' م' }) %><div class="muted small">مقادیر به میلیون <%= S('currency_label') %></div></div>
<div class="card flush"><h3 style="padding:1rem 1rem 0">درآمد روزانه</h3><div class="table-wrap"><table class="t"><thead><tr><th>تاریخ</th><th>مبلغ</th></tr></thead><tbody><% Object.keys(d.byDay).sort().forEach(function(day){ %><tr><td><%= ld(day) %></td><td class="num"><%= money(d.byDay[day]) %></td></tr><% }) %><% if (!Object.keys(d.byDay).length) { %><tr><td colspan="2" class="muted" style="text-align:center">پرداختی در این ماه نیست.</td></tr><% } %></tbody></table></div></div>
