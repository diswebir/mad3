<div class="page-head"><div><div class="crumbs"><a href="<%= u('/finance') %>">امور مالی</a> / جدید</div><h1>صورت‌حساب جدید</h1></div></div>
<form class="card" method="post" action="<%= u('/finance/fees/new') %>" autocomplete="off"><input type="hidden" name="_csrf" value="<%= csrf %>">
<% if (errors.length) { %><div class="alert error"><ul><% errors.forEach(function(e){ %><li><%= e %></li><% }) %></ul></div><% } %>
<div class="form-grid">
  <div class="field full"><label>اعمال برای</label><div style="display:flex;gap:1.5rem"><label class="check"><input type="radio" name="target" value="student" <%= vals.target !== 'class' ? 'checked' : '' %>> یک دانش‌آموز</label><label class="check"><input type="radio" name="target" value="class" <%= vals.target === 'class' ? 'checked' : '' %>> همه دانش‌آموزان یک کلاس</label></div></div>
  <div class="field"><label>دانش‌آموز</label><select name="student_id"><option value="">— انتخاب —</option><% students.forEach(function(s){ %><option value="<%= s.id %>" <%= String(vals.student_id) === String(s.id) ? 'selected' : '' %>><%= s.last_name %> <%= s.first_name %> — <%= s.cname || '' %></option><% }) %></select></div>
  <div class="field"><label>کلاس</label><select name="classroom_id"><option value="">— انتخاب —</option><% classes.forEach(function(c){ %><option value="<%= c.id %>" <%= String(vals.classroom_id) === String(c.id) ? 'selected' : '' %>><%= c.name %></option><% }) %></select></div>
  <div class="field"><label>عنوان *</label><input type="text" name="title" value="<%= vals.title || '' %>" required placeholder="مثلاً شهریه نوبت دوم"></div>
  <div class="field"><label>دسته</label><select name="category"><% categories.forEach(function(c){ %><option value="<%= c[0] %>" <%= vals.category === c[0] ? 'selected' : '' %>><%= c[1] %></option><% }) %></select></div>
  <div class="field"><label>مبلغ (<%= S('currency_label') %>) *</label><input type="text" class="digits ltr" name="amount" value="<%= vals.amount || '' %>" required></div>
  <div class="field"><label>تخفیف</label><input type="text" class="digits ltr" name="discount" value="<%= vals.discount || 0 %>"></div>
  <div class="field"><label>سررسید</label><input class="jdate ltr" type="text" name="due_date" value="<%= vals.due_date || '' %>" autocomplete="off"></div>
  <div class="field full"><label>توضیحات</label><textarea name="notes" style="min-height:60px"><%= vals.notes || '' %></textarea></div></div>
<div class="form-actions"><button class="btn primary"><%- icon('save', 16) %> ثبت</button><a class="btn" href="<%= u('/finance') %>">انصراف</a></div></form>
