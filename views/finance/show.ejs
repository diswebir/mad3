<div class="page-head"><div><div class="crumbs"><a href="<%= u('/finance') %>">امور مالی</a></div><h1><%= f.title %></h1><div class="muted"><%= f.first_name %> <%= f.last_name %> — <%= f.class_name || '' %> — <%= L.feeCategory[f.category] %></div></div>
<% if (isManager) { %><div class="actions"><form method="post" action="<%= u('/finance/fees/' + f.id + '/delete') %>" data-confirm="صورت‌حساب حذف شود؟"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn danger"><%- icon('trash-2', 16) %> حذف</button></form></div><% } %></div>
<div class="grid g4" style="margin-bottom:1rem"><div class="card stat" style="margin:0"><div><div class="v" style="font-size:1.2rem"><%= money(f.amount) %></div><div class="l">مبلغ</div></div></div><div class="card stat" style="margin:0"><div><div class="v" style="font-size:1.2rem"><%= money(f.discount || 0) %></div><div class="l">تخفیف</div></div></div><div class="card stat green" style="margin:0"><div><div class="v" style="font-size:1.2rem"><%= money(f.paid) %></div><div class="l">پرداخت‌شده</div></div></div><div class="card stat red" style="margin:0"><div><div class="v" style="font-size:1.2rem"><%= money(f.remaining) %></div><div class="l">مانده</div></div></div></div>
<% if (insts.length) { %><div class="card flush" style="margin-bottom:1rem"><div class="card-title">اقساط</div><div class="table-wrap"><table class="t"><thead><tr><th>قسط</th><th>سررسید</th><th>مبلغ</th><th>پرداخت‌شده</th><th>وضعیت</th></tr></thead><tbody><% insts.forEach(function(i){ %><tr><td><%= fa(i.seq) %></td><td><%= i.due_date ? d(i.due_date) : '—' %></td><td class="num"><%= money(i.amount) %></td><td class="num"><%= money(i.paid) %></td><td><%- i.state === 'paid' ? pill('پرداخت شد', 'green') : i.overdue ? pill('سررسید گذشته', 'red') : i.state === 'partial' ? pill('بخشی', 'amber') : pill('در انتظار', 'gray') %></td></tr><% }) %></tbody></table></div></div><% } %>
<% if (f.discount_note) { %><div class="alert info"><%- icon('info', 18) %><div><%= f.discount_note %></div></div><% } %>
<div class="grid g-side"><div class="card flush"><div class="card-title">پرداخت‌ها</div><% if (!payments.length) { %><div class="empty">پرداختی ثبت نشده است.</div><% } else { %><div class="table-wrap"><table class="t"><thead><tr><th>شماره سند</th><th>تاریخ</th><th>مبلغ</th><th>روش</th><th>شماره پیگیری</th><th></th></tr></thead><tbody><% payments.forEach(function(p){ %><tr style="<%= p.voided ? 'opacity:.55;text-decoration:line-through' : '' %>"><td class="ltr num"><%= p.doc_no ? fa(p.doc_no) : fa(p.id) %></td><td><%= d(p.paid_at) %></td><td class="num"><%= money(p.amount) %></td><td><%= L.payMethod[p.method] %></td><td class="ltr num"><%= fa(p.reference || '—') %></td><td class="actions"><a class="btn sm ghost" href="<%= u('/finance/receipt/' + p.id) %>"><%- icon('printer', 15) %> رسید</a><% if (p.voided) { %><%- pill('باطل شد', 'red') %> <span class="muted small"><%= p.void_reason %></span><% } else if (isManager) { %><form method="post" style="display:inline-flex;gap:.3rem" action="<%= u('/finance/payments/' + p.id + '/void') %>" data-confirm="این پرداخت باطل شود؟"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="text" name="reason" placeholder="دلیل ابطال" required minlength="3" style="width:120px"><button class="btn sm ghost" style="color:var(--red)"><%- icon('ban', 15) %> ابطال</button></form><% } %></td></tr><% }) %></tbody></table></div><% } %></div>
<% if (isManager && f.remaining > 0) { %><form class="card" method="post" action="<%= u('/finance/fees/' + f.id + '/pay') %>" autocomplete="off"><input type="hidden" name="_csrf" value="<%= csrf %>"><h3><%- icon('hand-coins', 18) %> ثبت پرداخت</h3>
<div class="field" style="margin-bottom:.6rem"><label>مبلغ (حداکثر <%= money(f.remaining) %>)</label><input type="text" class="digits ltr" name="amount" value="<%= f.remaining %>" required></div>
<div class="field" style="margin-bottom:.6rem"><label>تاریخ پرداخت</label><input class="jdate ltr" type="text" name="paid_at" value="<%= today %>" autocomplete="off"></div>
<div class="field" style="margin-bottom:.6rem"><label>روش</label><select name="method"><% Object.keys(L.payMethod).forEach(function(k){ %><option value="<%= k %>"><%= L.payMethod[k] %></option><% }) %></select></div>
<div class="field"><label>شماره پیگیری / چک</label><input type="text" class="ltr" name="reference"></div><button class="btn primary" style="margin-top:.8rem"><%- icon('save', 16) %> ثبت پرداخت</button></form><% } %></div>
