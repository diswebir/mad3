<div class="page-head"><div><div class="crumbs"><a href="<%= u('/finance') %>">امور مالی</a></div><h1><%- icon('triangle-alert', 24) %> بدهکاران</h1><div class="muted">جمع بدهی: <b><%= money(total) %></b> <%= S('currency_label') %></div></div><div class="actions"><a class="btn" href="?format=csv"><%- icon('download', 16) %> CSV</a><button class="btn" data-print><%- icon('printer', 16) %> چاپ</button></div></div>
<div class="card flush"><% if (!list.length) { %><div class="empty"><%- icon('circle-check', 42) %><div>بدهکاری وجود ندارد 🎉</div></div><% } else { %><div class="table-wrap"><table class="t"><thead><tr><th>دانش‌آموز</th><th>کلاس</th><th>تماس اولیا</th><th>مانده</th><th>سررسید گذشته</th></tr></thead><tbody><% list.forEach(function(x){ %><tr><td><a href="<%= u('/students/' + x.id + '?tab=finance') %>"><%= x.name %></a></td><td><%= x.class_name || '' %></td><td class="ltr num"><%= fa(x.phone || '—') %></td><td class="num"><b><%= money(x.remaining) %></b></td><td class="num" style="color:var(--red)"><%= x.overdue ? money(x.overdue) : '—' %></td></tr><% }) %></tbody></table></div><% } %></div>
