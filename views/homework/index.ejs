<div class="page-head"><div><h1><%- icon('notebook-pen', 24) %> تکالیف</h1></div><div class="actions">
<% if (user.role !== 'student') { %><% if (classes.length > 1 && isManager) { %><form method="get"><select name="class_id" data-autosubmit style="width:auto"><option value="">همه کلاس‌ها</option><% classes.forEach(function(c){ %><option value="<%= c.id %>" <%= String(classId) === String(c.id) ? 'selected' : '' %>><%= c.name %></option><% }) %></select></form><% } %><a class="btn primary" href="<%= u('/homework/new') %>"><%- icon('plus', 16) %> تکلیف جدید</a><% } %></div></div>
<div class="card flush"><% if (!rows.length) { %><div class="empty"><%- icon('notebook-pen', 42) %><div>تکلیفی ثبت نشده است.</div></div><% } else { %>
<div class="table-wrap"><table class="t"><thead><tr><th>تکلیف</th><th>درس / کلاس</th><th>مهلت تحویل</th><th><%= user.role === 'student' ? 'وضعیت من' : 'تحویل‌شده' %></th></tr></thead><tbody>
<% rows.forEach(function(h){ var over = h.due_date && h.due_date < today; %><tr><td><a href="<%= u('/homework/' + h.id) %>"><b><%= h.title %></b></a></td><td><%= h.subject_name %> <span class="muted">— <%= h.class_name %></span></td><td><%= h.due_date ? d(h.due_date) : '—' %> <% if (over) { %><span class="badge gray">سررسید گذشته</span><% } %></td>
<td><% if (user.role === 'student') { %><%- h.sub_id ? (h.my_score !== null ? pill('نمره: ' + fa(h.my_score), 'green') : pill(h.my_late ? 'تحویل با تأخیر' : 'تحویل شد', 'blue')) : (over ? pill('تحویل نشده', 'red') : pill('در انتظار', 'amber')) %><% } else { %><div style="display:flex;gap:.5rem;align-items:center"><div class="progress" style="width:90px"><i style="width:<%= h.stu_count ? Math.round(h.sub_count * 100 / h.stu_count) : 0 %>%"></i></div><span class="small num"><%= fa(h.sub_count) %>/<%= fa(h.stu_count) %></span></div><% } %></td></tr><% }) %></tbody></table></div><% } %></div>
<%- include('../partials/pager', { page: page, pages: pages }) %>
