<div class="page-head"><div><h1><%- icon('archive', 24) %> کلاس‌های بایگانی‌شده</h1><div class="muted small">نمرات و حضور و غیاب کلاس‌های سال‌های گذشته برای مشاهده نگهداری می‌شود.</div></div><div class="actions"><a class="btn" href="<%= u('/promotion') %>">بازگشت</a></div></div>
<div class="card flush"><div class="table-wrap"><table class="t"><thead><tr><th>کلاس</th><th>پایه</th><th>سال</th><th></th></tr></thead><tbody>
<% if (!rows.length) { %><tr><td colspan="4" class="muted" style="text-align:center">هنوز کلاسی بایگانی نشده است.</td></tr><% } %>
<% rows.forEach(function(c){ %><tr><td><b><%= c.name %></b></td><td><%= c.grade_level %></td><td><%= c.year_title || '—' %></td><td class="actions"><a class="btn sm" href="<%= u('/classes/' + c.id) %>">مشاهده</a><% if (enabled('grades')) { %> <a class="btn sm ghost" href="<%= u('/grades/class/' + c.id) %>">نتایج کلاس</a><% } %><% if (enabled('attendance')) { %> <a class="btn sm ghost" href="<%= u('/attendance/report?class_id=' + c.id) %>">حضور و غیاب</a><% } %></td></tr><% }) %></tbody></table></div></div>
