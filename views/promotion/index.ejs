<div class="page-head"><div><h1><%- icon('layers', 24) %> پایان سال تحصیلی</h1><div class="muted small">ارتقای دسته‌جمعی پایه، تکرار پایه، فارغ‌التحصیلی و آغاز سال جدید در سه گام.</div></div><div class="actions"><a class="btn" href="<%= u('/promotion/archive') %>"><%- icon('archive', 16) %> کلاس‌های بایگانی‌شده</a></div></div>
<div class="steps"><span class="s cur">۱) سال جدید</span><span class="s">۲) تعیین وضعیت دانش‌آموزان</span><span class="s">۳) تأیید و اجرا</span></div>
<div class="grid g3"><div class="card stat blue" style="margin:0"><div><div class="v"><%= fa(students) %></div><div class="l">دانش‌آموز فعال</div></div></div><div class="card stat" style="margin:0"><div><div class="v"><%= fa(activeClasses) %></div><div class="l">کلاس فعال</div></div></div><div class="card stat amber" style="margin:0"><div><div class="v"><%= cur ? cur.title : '—' %></div><div class="l">سال جاری</div></div></div></div>
<div class="alert warn" style="margin-top:1rem"><%- icon('triangle-alert', 18) %><div><b>پیش از اجرا به‌طور خودکار یک نسخه‌ی پشتیبان کامل گرفته می‌شود</b> (<a href="<%= u('/backup') %>">پشتیبان‌گیری</a>) و تا زمانی که در کلاس‌های جدید حضور و غیاب یا ارزشیابی ثبت نشده، می‌توانید ارتقا را «بازگردانی» کنید. کلاس‌ها به‌صورت «جایگاه» حفظ می‌شوند: دروس، معلمان، معلم راهنما و برنامه‌ی هفتگی هر کلاس به سال جدید منتقل می‌شود و کلاس‌های قدیمی همراه نمرات و حضور و غیابشان بایگانی می‌شوند.</div></div>
<% if (closed) { %><div class="alert error"><%- icon('lock', 18) %><div>سوابق سال جاری (<%= cur.title %>) قبلاً بایگانی شده است.</div></div><% } %>
<form method="post" action="<%= u('/promotion/plan') %>" class="card" style="max-width:640px"><input type="hidden" name="_csrf" value="<%= csrf %>"><h3>گام ۱: مشخصات سال تحصیلی جدید</h3>
<div class="form-grid"><div class="field full"><label>عنوان سال جدید *</label><input type="text" class="ltr" name="year_title" value="<%= vals.year_title %>" required pattern="\d{4}\s*[-–/]\s*\d{4}" placeholder="1405-1406"></div>
<div class="field"><label>شروع سال</label><input class="jdate ltr" type="text" name="year_start" value="<%= vals.year_start %>" autocomplete="off"></div><div class="field"><label>پایان سال</label><input class="jdate ltr" type="text" name="year_end" value="<%= vals.year_end %>" autocomplete="off"></div></div>
<div class="form-actions"><button class="btn primary" <%= closed || !activeClasses ? 'disabled' : '' %>>ادامه: تعیین وضعیت دانش‌آموزان <%- icon('arrow-left', 16) %></button></div></form>
<div class="card flush"><h3 style="padding:1rem 1rem 0">سال‌های تحصیلی</h3><div class="table-wrap"><table class="t"><thead><tr><th>سال</th><th>وضعیت</th><th>سوابق بایگانی‌شده</th></tr></thead><tbody><% years.forEach(function(y){ %><tr><td><b><%= y.title %></b></td><td><%- y.is_current ? pill('جاری', 'green') : pill('گذشته', 'gray') %></td><td><%= fa(yearStats[y.id] || 0) %> دانش‌آموز</td></tr><% }) %></tbody></table></div></div>
<% if (runs && runs.length) { %><div class="card flush" style="margin-top:1rem"><div class="card-title" style="padding:.8rem 1rem"><%- icon('history', 18) %> سابقه‌ی ارتقاها و بازگردانی</div><div class="table-wrap"><table class="t"><thead><tr><th>سال جدید</th><th>زمان</th><th>پشتیبان خودکار</th><th>وضعیت</th><th></th></tr></thead><tbody>
<% runs.forEach(function(r){ %><tr><td><b><%= fa(r.new_year_title) %></b></td><td class="small"><%= dt(r.created_at) %></td><td class="ltr small"><%= r.backup_file ? r.backup_file : '—' %></td><td><%- r.undone_at ? pill('بازگردانده شد', 'amber') : pill('اجرا شده', 'green') %></td>
<td><% if (lastRun && lastRun.id === r.id) { %><form method="post" action="<%= u('/promotion/undo/' + r.id) %>" style="display:flex;gap:.3rem"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="text" name="confirm" class="ltr" placeholder="UNDO" style="width:80px" autocomplete="off"><button class="btn sm danger" data-confirm="ارتقا بازگردانده شود؟ دانش‌آموزان و کلاس‌ها به وضعیت پیش از ارتقا برمی‌گردند."><%- icon('undo-2', 14) %> بازگردانی</button></form><% } %></td></tr><% }) %></tbody></table></div></div><% } %>
