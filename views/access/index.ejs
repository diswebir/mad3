<div class="page-head"><div><h1><%- icon('key-round', 24) %> سطوح دسترسی</h1><div class="muted small"><%= fa(regCount) %> قابلیت در <%= fa(groupCount) %> بخش — برای هر نفر جداگانه «مجاز / ممنوع / پیش‌فرض» تعیین کنید.</div></div>
<div class="actions"><a class="btn primary" href="<%= u('/access/profiles/new') %>"><%- icon('plus', 16) %> الگوی جدید</a></div></div>
<div class="tabs"><a href="<%= u('/access?tab=people') %>" class="<%= tab === 'people' ? 'active' : '' %>">افراد</a><a href="<%= u('/access?tab=profiles') %>" class="<%= tab === 'profiles' ? 'active' : '' %>">الگوهای دسترسی (<%= fa(profiles.length) %>)</a><a href="<%= u('/access?tab=log') %>" class="<%= tab === 'log' ? 'active' : '' %>">گزارش تغییرات و ردها</a></div>
<% if (tab === 'people') { %>
<div class="card flush"><form class="toolbar" method="get"><input type="hidden" name="tab" value="people"><input type="text" name="q" value="<%= q %>" placeholder="جستجوی نام یا نام کاربری">
<select name="role" data-autosubmit><option value="">معلمان و معاونان</option><option value="teacher" <%= role === 'teacher' ? 'selected' : '' %>>فقط معلمان</option><option value="deputy" <%= role === 'deputy' ? 'selected' : '' %>>فقط معاونان</option></select><button class="btn"><%- icon('filter', 15) %> اعمال</button></form>
<div class="table-wrap"><table class="t"><thead><tr><th>نام</th><th>نقش</th><th>الگو</th><th>مجوز اضافه</th><th>ممنوعیت</th><th></th></tr></thead><tbody>
<% rows.forEach(function (r) { %><tr><td><b><%= r.full_name %></b><div class="muted small ltr"><%= r.username %></div></td><td><%= L.roles[r.role] %><% if (r.title) { %><div class="muted small"><%= r.title %></div><% } %></td>
<td><%- r.profile ? pill(r.profile, 'blue') : '<span class="muted">—</span>' %></td><td><%- r.nAllow ? pill(fa(r.nAllow) + ' مورد', 'green') : '<span class="muted">—</span>' %></td><td><%- r.nDeny ? pill(fa(r.nDeny) + ' مورد', 'red') : '<span class="muted">—</span>' %></td>
<td class="actions"><a class="btn sm primary" href="<%= u('/access/user/' + r.id) %>"><%- icon('sliders-horizontal', 15) %> تنظیم دسترسی</a></td></tr>
<% }) %><% if (!rows.length) { %><tr><td colspan="6" class="center muted">کاربری یافت نشد.</td></tr><% } %></tbody></table></div></div>
<% } else if (tab === 'profiles') { %>
<div class="card flush"><div class="table-wrap"><table class="t"><thead><tr><th>الگو</th><th>مخصوص</th><th>مجاز</th><th>ممنوع</th><th>کاربران</th><th></th></tr></thead><tbody>
<% profiles.forEach(function (p) { %><tr><td><b><%= p.name %></b><div class="muted small"><%= p.description || '' %></div></td><td><%= L.roles[p.base_role] %></td><td><%- pill(fa(p.nAllow), 'green') %></td><td><%- pill(fa(p.nDeny), 'red') %></td><td><%= fa(p.users) %></td>
<td class="actions"><a class="btn sm ghost" href="<%= u('/access/profiles/' + p.id + '/edit') %>"><%- icon('pencil', 15) %></a>
<form method="post" action="<%= u('/access/profiles/' + p.id + '/delete') %>" style="display:inline" data-confirm="این الگو حذف شود؟"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm ghost danger"><%- icon('trash-2', 15) %></button></form></td></tr>
<% }) %><% if (!profiles.length) { %><tr><td colspan="6" class="center muted">الگویی ساخته نشده است.</td></tr><% } %></tbody></table></div></div>
<% } else { %>
<div class="card flush"><div class="table-wrap"><table class="t"><thead><tr><th>زمان</th><th>عامل</th><th>رویداد</th><th>جزئیات</th><th>IP</th></tr></thead><tbody>
<% logs.forEach(function (l) { %><tr><td class="nowrap small"><%= dt(l.created_at) %></td><td><%= l.user_name || '—' %></td><td><%- l.action === 'denied' ? pill('رد دسترسی', 'red') : pill('تغییر مجوز', 'blue') %></td><td class="small ltr" style="max-width:520px;word-break:break-word"><%= l.entity_id %> <%= l.details %></td><td class="ltr small"><%= l.ip %></td></tr>
<% }) %><% if (!logs.length) { %><tr><td colspan="5" class="center muted">رویدادی ثبت نشده است.</td></tr><% } %></tbody></table></div><%- include('../partials/pager', { page: page, pages: pages }) %></div>
<% } %>
