<div class="page-head"><div><h1><%- icon('history', 24) %> گزارش فعالیت‌ها</h1><div class="muted small"><%= fa(total) %> رویداد</div></div></div>
<div class="card flush"><form class="toolbar" method="get"><input type="text" name="q" value="<%= q %>" placeholder="جستجوی کاربر یا جزئیات"><select name="action" data-autosubmit><option value="">همه عملیات</option><% actions.forEach(function(a){ %><option <%= a === action ? 'selected' : '' %>><%= a %></option><% }) %></select><button class="btn"><%- icon('search', 15) %> جستجو</button></form>
<div class="table-wrap"><table class="t"><thead><tr><th>زمان</th><th>کاربر</th><th>عملیات</th><th>موجودیت</th><th>جزئیات</th><th>IP</th></tr></thead><tbody>
<% rows.forEach(function(r){ %><tr><td class="nowrap small"><%= dt(r.created_at) %></td><td><%= r.user_name || '—' %></td><td><span class="badge blue ltr"><%= r.action %></span></td><td class="ltr small"><%= r.entity || '' %><%= r.entity_id ? '#' + r.entity_id : '' %></td><td class="small"><%= r.details || '' %></td><td class="ltr small muted"><%= r.ip || '' %></td></tr><% }) %></tbody></table></div>
<%- include('../partials/pager', { page: page, pages: pages }) %></div>
