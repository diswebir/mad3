<div class="page-head"><div><h1><%- icon('clock', 24) %> گزارش تأخیرها</h1><div class="muted"><%= ld(from) %> تا <%= ld(to) %></div></div><div class="actions"><a class="btn" href="?from=<%= J.isoToJString(from) %>&to=<%= J.isoToJString(to) %>&class_id=<%= classId || '' %>&format=csv"><%- icon('download', 16) %> CSV</a><button class="btn" data-print><%- icon('printer', 16) %> چاپ</button></div></div>
<form class="card" method="get" style="display:flex;gap:.8rem;align-items:end;flex-wrap:wrap"><div class="field"><label>از</label><input class="jdate ltr" type="text" name="from" value="<%= J.isoToJString(from) %>" autocomplete="off"></div><div class="field"><label>تا</label><input class="jdate ltr" type="text" name="to" value="<%= J.isoToJString(to) %>" autocomplete="off"></div>
<div class="field"><label>کلاس</label><select name="class_id"><option value="">همه</option><% classes.forEach(function(c){ %><option value="<%= c.id %>" <%= classId === c.id ? 'selected' : '' %>><%= c.name %></option><% }) %></select></div><button class="btn primary"><%- icon('filter', 15) %> نمایش</button></form>
<div class="grid g3"><div class="card stat amber" style="margin:0"><div><div class="v"><%= fa(total) %></div><div class="l">کل تأخیرها</div></div></div><div class="card stat blue" style="margin:0"><div><div class="v"><%= avgMin === null ? '—' : fa(avgMin) %></div><div class="l">میانگین دقیقه‌ی تأخیر (از ورودهای ثبت‌شده با QR)</div></div></div><div class="card stat" style="margin:0"><div><div class="v"><%= fa(ranking.length) %></div><div class="l">دانش‌آموز دارای تأخیر</div></div></div></div>
<div class="grid g2" style="margin-top:1rem"><div class="card flush"><h3 style="padding:1rem 1rem 0">پرتأخیرترین‌ها</h3><div class="table-wrap"><table class="t"><thead><tr><th>#</th><th>دانش‌آموز</th><th>کلاس</th><th>تعداد</th></tr></thead><tbody>
<% if (!ranking.length) { %><tr><td colspan="4" class="muted" style="text-align:center">تأخیری ثبت نشده است.</td></tr><% } %>
<% ranking.forEach(function(r, i){ %><tr><td><%= fa(i + 1) %></td><td><a href="<%= u('/students/' + r.id) %>"><%= r.first_name %> <%= r.last_name %></a></td><td><%= r.class_name %></td><td><b><%= fa(r.n) %></b></td></tr><% }) %></tbody></table></div></div>
<div class="card"><h3>توزیع بر اساس روز هفته</h3><% var mx = Math.max.apply(null, byDow.concat([1])); byDow.forEach(function(n, i){ if (i === 6) return; %><div style="display:flex;align-items:center;gap:.6rem;margin:.4rem 0"><span style="width:70px"><%= J.WEEKDAYS[i] %></span><div style="flex:1;background:var(--bg);border-radius:6px;height:14px"><div style="width:<%= Math.round(n * 100 / mx) %>%;height:14px;border-radius:6px;background:var(--amber)"></div></div><b><%= fa(n) %></b></div><% }) %></div></div>
