<div class="page-head"><div><h1><%- icon('calendar-check', 24) %> حضور و غیاب من</h1></div></div>
<div class="grid g4" style="margin-bottom:1rem"><% ['present','absent','late','excused'].forEach(function(k){ %><div class="card stat <%= k === 'present' ? 'green' : k === 'absent' ? 'red' : k === 'late' ? 'amber' : '' %>" style="margin:0"><div><div class="v"><%= fa(totals[k] || 0) %></div><div class="l"><%= L.attendance[k] %> (کل سال)</div></div></div><% }) %></div>
<form class="card" method="get" style="display:flex;gap:.8rem;align-items:end"><div class="field"><label>ماه</label><select name="month" data-autosubmit><% J.MONTHS.forEach(function(m, i){ %><option value="<%= i + 1 %>" <%= jm === i + 1 ? 'selected' : '' %>><%= m %></option><% }) %></select></div><div class="field"><label>سال</label><input type="text" class="digits ltr" name="year" value="<%= jy %>" style="width:90px" data-autosubmit></div><% if (rate !== null) { %><div class="muted">درصد حضور کل سال: <b><%= fa(rate) %>٪</b></div><% } %></form>
<div class="card flush"><% if (!rows.length) { %><div class="empty">در این ماه سابقه‌ای ثبت نشده است.</div><% } else { %><div class="table-wrap"><table class="t"><thead><tr><th>تاریخ</th><th>روز</th><th>وضعیت</th><th>توضیح</th><th></th></tr></thead><tbody>
<% rows.forEach(function(a){ var j = justified[a.date]; %><tr><td><%= d(a.date) %></td><td><%= J.WEEKDAYS[J.dow(a.date)] %></td><td><%- pill(L.attendance[a.status], badges_map.attendance[a.status]) %></td><td><%= a.note || '' %></td>
<td class="actions"><% if (a.status === 'absent' && enabled('tickets')) { %><% if (j) { %><a class="btn sm ghost" href="<%= u('/tickets/' + j.id) %>"><%- icon('life-buoy', 15) %> مشاهده تیکت توجیه</a><% } else { %><a class="btn sm" href="<%= u('/tickets/new?category=absence&date=' + a.date) %>"><%- icon('send', 15) %> توجیه غیبت</a><% } %><% } %></td></tr><% }) %></tbody></table></div><% } %></div>
