<div class="page-head"><div><h1><%- icon('phone', 24) %> غایبین و متأخرین روز</h1><div class="muted"><%= ld(date) %> (<%= J.WEEKDAYS[J.dow(date)] %>)</div></div><div class="actions"><button class="btn" data-print><%- icon('printer', 16) %> چاپ</button></div></div>
<form class="card" method="get" style="display:flex;gap:.8rem;align-items:end"><div class="field"><label>تاریخ</label><input class="jdate ltr" type="text" name="date" value="<%= J.isoToJString(date) %>" data-autosubmit autocomplete="off"></div><button class="btn">نمایش</button></form>
<div class="card flush"><% if (!rows.length) { %><div class="empty"><%- icon('circle-check', 42) %><div>غایب یا متأخری برای این روز ثبت نشده است.</div></div><% } else { %>
<div class="table-wrap"><table class="t"><thead><tr><th>دانش‌آموز</th><th>کلاس</th><th>وضعیت</th><th>تماس اولیا</th><th>توضیح</th></tr></thead><tbody>
<% rows.forEach(function(r){ %><tr><td><a href="<%= u('/students/' + r.id) %>"><%= r.first_name %> <%= r.last_name %></a></td><td><%= r.class_name %></td><td><%- pill(L.attendance[r.status], badges_map.attendance[r.status]) %></td><td class="ltr num"><%= fa(r.father_phone || '—') %> <span class="muted">/</span> <%= fa(r.mother_phone || r.guardian_phone || '—') %></td><td><%= r.note || '' %></td></tr><% }) %></tbody></table></div><% } %></div>
