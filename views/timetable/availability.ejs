<div class="page-head"><div><div class="crumbs"><a href="<%= u('/timetable') %>">برنامه هفتگی</a></div><h1><%- icon('user-cog', 24) %> ساعت‌های غیرمجاز معلم</h1><div class="muted small">ساعت‌هایی که معلم حضور ندارد؛ در تولید خودکار برنامه و ثبت دستی رعایت می‌شود.</div></div></div>
<% if (!readOnly) { %><form class="card" method="get" style="display:flex;gap:.8rem;align-items:end"><div class="field"><label>معلم</label><select name="teacher_id" data-autosubmit><% teachers.forEach(function(t){ %><option value="<%= t.id %>" <%= t.id === tid ? 'selected' : '' %>><%= t.full_name %></option><% }) %></select></div></form><% } %>
<% if (!tid) { %><div class="card empty">معلمی وجود ندارد.</div><% } else { %>
<form method="post" action="<%= u('/timetable/availability') %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="teacher_id" value="<%= tid %>">
<div class="card flush"><div class="table-wrap"><table class="t tt"><thead><tr><th>زنگ</th><% days.forEach(function(d){ %><th><%= WEEKDAYS[d] %></th><% }) %></tr></thead><tbody>
<% periods.forEach(function(p){ %><tr><th><%= fa(p.n) %><div class="muted small" style="font-weight:400"><%= fa(p.start) %> - <%= fa(p.end) %></div></th><% days.forEach(function(d){ %><td class="cell" style="text-align:center"><label class="check" style="justify-content:center"><input type="checkbox" name="off" value="<%= d %>-<%= p.n %>" <%= off.has(d + '-' + p.n) ? 'checked' : '' %> <%= readOnly ? 'disabled' : '' %>> غیرمجاز</label></td><% }) %></tr><% }) %></tbody></table></div></div>
<% if (!readOnly) { %><div class="form-actions"><button class="btn primary"><%- icon('save', 16) %> ذخیره</button></div><% } %></form><% } %>
