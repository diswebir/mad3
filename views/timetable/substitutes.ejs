<div class="page-head"><div><div class="crumbs"><a href="<%= u('/timetable') %>">برنامه هفتگی</a></div><h1><%- icon('user-check', 24) %> جانشین‌یابی معلم غایب</h1><div class="muted"><%= ld(date) %> (<%= J.WEEKDAYS[J.dow(date)] %>)</div></div></div>
<form class="card" method="get" style="display:flex;gap:.8rem;align-items:end;flex-wrap:wrap"><div class="field"><label>تاریخ</label><input class="jdate ltr" type="text" name="date" value="<%= J.isoToJString(date) %>" autocomplete="off"></div>
<div class="field"><label>معلم غایب</label><select name="teacher_id"><option value="">—</option><% teachers.forEach(function(t){ %><option value="<%= t.id %>" <%= t.id === tid ? 'selected' : '' %>><%= t.full_name %><%= onLeave.indexOf(t.id) >= 0 ? ' (در مرخصی)' : '' %></option><% }) %></select></div><button class="btn primary">نمایش</button></form>
<% if (tid) { %><form method="post" action="<%= u('/timetable/substitutes') %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="date" value="<%= J.isoToJString(date) %>"><input type="hidden" name="teacher_id" value="<%= tid %>">
<div class="card flush"><h3 style="padding:1rem 1rem 0">زنگ‌های معلم در این روز</h3><div class="table-wrap"><table class="t"><thead><tr><th>زنگ</th><th>کلاس</th><th>درس</th><th>جانشین</th></tr></thead><tbody>
<% if (!mine.length) { %><tr><td colspan="4" class="muted" style="text-align:center">این معلم در این روز زنگی ندارد.</td></tr><% } %>
<% mine.forEach(function(s){ %><tr><td><%= fa(s.period) %></td><td><%= s.class_name %></td><td><%= s.subject %></td><td><select name="sub[<%= s.classroom_id %>-<%= s.period %>]"><option value="">— بدون جانشین —</option><% s.options.forEach(function(o){ %><option value="<%= o.id %>" <%= s.current && s.current.substitute_teacher_id === o.id ? 'selected' : '' %>><%= o.full_name %></option><% }) %><% if (s.current && !s.options.some(function(o){ return o.id === s.current.substitute_teacher_id; })) { %><option value="<%= s.current.substitute_teacher_id %>" selected>(انتخاب‌شده)</option><% } %></select><% if (!s.options.length) { %> <span class="badge red">معلم آزاد نیست</span><% } %></td></tr><% }) %></tbody></table></div></div>
<div class="field" style="max-width:420px;margin:.8rem 0"><label>توضیح</label><input type="text" name="note" maxlength="200"></div><button class="btn primary"><%- icon('save', 16) %> ذخیره و اطلاع‌رسانی به جانشین‌ها</button></form><% } %>
<div class="card flush" style="margin-top:1rem"><h3 style="padding:1rem 1rem 0">جانشینی‌های ثبت‌شده‌ی این روز</h3><div class="table-wrap"><table class="t"><thead><tr><th>زنگ</th><th>کلاس</th><th>معلم غایب</th><th>جانشین</th></tr></thead><tbody>
<% if (!list.length) { %><tr><td colspan="4" class="muted" style="text-align:center">جانشینی ثبت نشده است.</td></tr><% } %>
<% list.forEach(function(s){ %><tr><td><%= fa(s.period) %></td><td><%= s.class_name %></td><td><%= s.absent_name || '—' %></td><td><b><%= s.sub_name %></b></td></tr><% }) %></tbody></table></div></div>
