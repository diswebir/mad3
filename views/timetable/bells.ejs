<div class="page-head"><div><div class="crumbs"><a href="<%= u('/timetable') %>">برنامه هفتگی</a></div><h1><%- icon('bell', 24) %> ساعت زنگ‌ها</h1><div class="muted">زمان شروع و پایان هر زنگ، تفریح، نماز و ناهار — یک الگوی پیش‌فرض و الگوهای ویژه‌ی روز/پایه</div></div>
<div class="actions"><a class="btn primary" href="<%= u('/timetable/bells/new') %>"><%- icon('plus', 16) %> الگوی ویژه</a></div></div>
<% if (orphans > 0) { %><div class="alert warn"><%- icon('triangle-alert', 18) %><div><%= fa(orphans) %> خانه از برنامه‌های هفتگی با ساعت زنگ‌ها/روزهای مدرسه ناسازگار است (نامرئی هستند ولی در شمارش می‌مانند).<form method="post" action="<%= u('/timetable/bells/cleanup') %>" style="display:inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm danger" data-confirm="خانه‌های نامعتبر پاک شود؟">پاک‌سازی</button></form></div></div><% } %>
<% list.forEach(function(s){ var cls = s.rows.filter(function(r){ return r.kind === 'class'; }); %>
<div class="card"><div class="card-title" style="justify-content:space-between"><span><%- icon('clock', 18) %> <%= s.name %> <% if (s.isDefault) { %><span class="badge blue">پیش‌فرض</span><% } else { %><span class="badge amber"><%= s.days.length ? s.days.map(function(d){ return WEEKDAYS[d]; }).join('، ') : 'همه‌ی روزها' %><%= s.grades.length ? ' · پایه‌ی ' + s.grades.join('، ') : '' %></span><% } %></span>
<span><a class="btn sm" href="<%= u('/timetable/bells/' + s.id + '/edit') %>"><%- icon('pencil', 14) %> ویرایش</a>
<% if (!s.isDefault) { %><form method="post" action="<%= u('/timetable/bells/' + s.id + '/delete') %>" style="display:inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm danger" data-confirm="این الگو حذف شود؟"><%- icon('trash-2', 14) %></button></form><% } %></span></div>
<div class="bell-strip"><% s.rows.forEach(function(r){ %><div class="bell-cell <%= r.kind %>" title="<%= KINDS[r.kind] %>"><b><%= r.kind === 'class' ? 'زنگ ' + fa(r.n) : (r.label || KINDS[r.kind]) %></b><span class="ltr"><%= fa(r.start) %> - <%= fa(r.end) %></span></div><% }) %></div>
<div class="muted small"><%= fa(cls.length) %> زنگ درسی · شروع <b><%= fa(cls.length ? cls[0].start : '—') %></b> · پایان <b><%= fa(s.rows.length ? s.rows[s.rows.length - 1].end : '—') %></b></div></div>
<% }) %>
<div class="card muted small">ساعت شروع زنگ اول، مبنای محاسبه‌ی «تأخیر ورود» (QR و حضور و غیاب) است؛ بنابراین جداگانه تنظیم نمی‌شود. اگر الگوی ویژه‌ای برای یک روز یا پایه تعریف کنید، همان‌جا ملاک است.</div>
