<div class="page-head"><div><div class="crumbs"><a href="<%= u('/timetable') %>">برنامه هفتگی</a></div><h1><%- icon('layout-grid', 24) %> نمای کل مدرسه <span class="muted small">— <%= by === 'teacher' ? 'برنامه‌ی همه‌ی معلمان' : 'برنامه‌ی همه‌ی کلاس‌ها' %></span></h1></div>
<div class="actions"><a class="btn <%= by === 'class' ? 'primary' : '' %>" href="<%= u('/timetable/overview?by=class') %>">کلاس‌ها</a><a class="btn <%= by === 'teacher' ? 'primary' : '' %>" href="<%= u('/timetable/overview?by=teacher') %>">معلمان</a>
<a class="btn" href="<%= u('/timetable/export.xlsx?all=1&by=' + by) %>"><%- icon('file-spreadsheet', 16) %> اکسل همه</a><button class="btn" data-print><%- icon('printer', 16) %> چاپ</button></div></div>
<% if (by === 'class') { %><form class="card tt-filter" method="get"><input type="hidden" name="by" value="class"><div class="field"><label>پایه</label><select name="grade" data-autosubmit><option value="">همه</option><% grades.forEach(function(g){ %><option <%= grade === g ? 'selected' : '' %>><%= g %></option><% }) %></select></div></form><% } %>
<% if (!groups.length) { %><div class="card empty">موردی برای نمایش نیست.</div><% } %>
<div class="ov-grid"><% groups.forEach(function(g){ %><div class="card flush ov-card"><div class="card-title" style="padding:.7rem 1rem"><b><%= g.title %></b><span class="muted small"><%= fa(g.total) %> ساعت</span></div><div class="table-wrap"><table class="t tt ov"><thead><tr><th></th><% days.forEach(function(d){ %><th><%= WEEKDAYS[d] %></th><% }) %></tr></thead><tbody>
<% for (var n = 1; n <= max; n++) { %><tr><th><%= fa(n) %></th><% days.forEach(function(d){ var c = g.cells[d + '-' + n]; %><td><% if (c) { %><b><%= c.a %></b><div class="muted small"><%= c.b %></div><% } %></td><% }) %></tr><% } %></tbody></table></div></div><% }) %></div>
