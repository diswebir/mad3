<div class="page-head"><div><div class="crumbs"><a href="<%= u('/timetable/bells') %>">ساعت زنگ‌ها</a></div><h1><%- icon('bell', 24) %> <%= title %></h1></div></div>
<% errors.forEach(function(e){ %><div class="alert error"><%- icon('circle-x', 18) %><div><%= e %></div></div><% }) %>
<form method="post" action="<%= u('/timetable/bells/save') %>" id="bell-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= sched.id || '' %>">
<div class="card"><div class="grid g2">
  <div class="field"><label>نام الگو</label><input type="text" name="name" required maxlength="100" value="<%= sched.name %>" placeholder="مثلاً: چهارشنبه‌های کوتاه"></div>
  <% if (sched.isDefault) { %><div class="field"><label>نوع</label><div class="muted">الگوی پیش‌فرض — برای همه‌ی روزها و پایه‌هایی که الگوی ویژه ندارند.</div></div><% } %>
</div>
<% if (!sched.isDefault) { %><div class="grid g2"><div class="field"><label>روزهایی که این الگو برقرار است</label><div class="checks"><% activeDays.forEach(function(d){ %><label class="chk"><input type="checkbox" name="days" value="<%= d %>" <%= (sched.days || []).indexOf(d) >= 0 ? 'checked' : '' %>> <%= WEEKDAYS[d] %></label><% }) %></div><div class="hint">خالی = همه‌ی روزها</div></div>
<div class="field"><label>پایه‌ها</label><div class="checks"><% grades.forEach(function(g){ %><label class="chk"><input type="checkbox" name="grades" value="<%= g %>" <%= (sched.grades || []).indexOf(g) >= 0 ? 'checked' : '' %>> <%= g %></label><% }) %></div><div class="hint">خالی = همه‌ی پایه‌ها</div></div></div><% } %></div>

<div class="card"><div class="card-title"><%- icon('wand-sparkles', 18) %> ساخت سریع از الگو</div>
<div class="grid g4" id="quick"><div class="field"><label>تعداد زنگ درسی</label><input type="number" id="q-count" min="1" max="12" value="6"></div><div class="field"><label>شروع زنگ اول</label><input type="text" id="q-start" class="ltr" value="07:45"></div><div class="field"><label>مدت هر زنگ (دقیقه)</label><input type="number" id="q-min" min="20" max="120" value="45"></div><div class="field"><label>تنفس بین زنگ‌ها</label><input type="number" id="q-brk" min="0" max="60" value="10"></div>
<div class="field"><label>تفریح/نماز بلند پس از زنگ</label><input type="number" id="q-long-after" min="0" max="11" value="0"><div class="hint">۰ = ندارد</div></div><div class="field"><label>نوع آن</label><select id="q-long-kind"><option value="break">تفریح</option><option value="prayer">نماز</option><option value="lunch">ناهار</option></select></div><div class="field"><label>مدت (دقیقه)</label><input type="number" id="q-long-min" min="5" max="120" value="20"></div><div class="field" style="align-self:end"><button type="button" class="btn" id="q-apply"><%- icon('wand-sparkles', 16) %> ساخت ردیف‌ها</button></div></div>
<div class="muted small">با زدن «ساخت ردیف‌ها»، جدول زیر جایگزین می‌شود؛ سپس هر ردیف را می‌توانید دستی تغییر دهید.</div></div>

<div class="card flush"><div class="table-wrap"><table class="t" id="bell-table"><thead><tr><th style="width:60px">#</th><th>نوع</th><th>عنوان (اختیاری)</th><th>شروع</th><th>پایان</th><th style="width:140px"></th></tr></thead><tbody>
<% (sched.rows || []).forEach(function(r, i){ %><tr><td class="ix"><%= fa(i + 1) %></td><td><select name="kind"><% Object.keys(KINDS).forEach(function(k){ %><option value="<%= k %>" <%= r.kind === k ? 'selected' : '' %>><%= KINDS[k] %></option><% }) %></select></td><td><input type="text" name="label" maxlength="60" value="<%= r.kind === 'class' ? '' : (r.label || '') %>"></td><td><input type="text" name="start" class="ltr" value="<%= r.start %>" pattern="[0-9]{1,2}:[0-9]{2}" required></td><td><input type="text" name="end" class="ltr" value="<%= r.end %>" pattern="[0-9]{1,2}:[0-9]{2}" required></td><td><button type="button" class="btn sm" data-up title="بالا">↑</button> <button type="button" class="btn sm" data-down title="پایین">↓</button> <button type="button" class="btn sm danger" data-del title="حذف">✕</button></td></tr><% }) %>
</tbody></table></div><div style="padding:.8rem"><button type="button" class="btn" id="add-row"><%- icon('plus', 16) %> افزودن ردیف</button></div></div>
<% if (orphanList) { %><div class="card"><label class="chk"><input type="checkbox" name="confirm_orphans" value="1"> <b>تأیید می‌کنم:</b> <%= fa(orphanList) %> خانه‌ی برنامه‌ی هفتگی که با این تغییر بی‌معنی می‌شود حذف شود.</label></div><% } %>
<div class="form-actions"><button class="btn primary"><%- icon('save', 16) %> ذخیره</button><a class="btn" href="<%= u('/timetable/bells') %>">انصراف</a></div></form>
<script src="<%= asset('js/bell-editor.js') %>" defer></script>
