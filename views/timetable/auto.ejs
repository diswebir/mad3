<div class="page-head"><div><div class="crumbs"><a href="<%= u('/timetable') %>">برنامه هفتگی</a></div><h1><%- icon('shuffle', 24) %> تولید خودکار برنامه‌ی هفتگی</h1><div class="muted small">دروس بر اساس «ساعت هفتگی» هر درس و معلم تعیین‌شده چیده می‌شوند؛ تداخل معلم/کلاس و ساعت‌های غیرمجاز معلمان رعایت می‌شود.</div></div><div class="actions"><a class="btn" href="<%= u('/timetable/availability') %>">ساعت‌های غیرمجاز</a></div></div>
<form method="post" action="<%= u('/timetable/auto') %>" class="card" style="max-width:640px"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="phase" value="preview">
<div class="form-grid"><div class="field"><label>دامنه</label><select name="scope"><option value="all" <%= f.scope !== 'class' ? 'selected' : '' %>>همه‌ی کلاس‌ها (برنامه‌ی فعلی جایگزین می‌شود)</option><option value="class" <%= f.scope === 'class' ? 'selected' : '' %>>فقط یک کلاس (کلاس‌های دیگر ثابت می‌مانند)</option></select></div>
<div class="field"><label>کلاس</label><select name="class_id"><option value="">—</option><% classes.forEach(function(c){ %><option value="<%= c.id %>" <%= String(f.class_id) === String(c.id) ? 'selected' : '' %>><%= c.name %></option><% }) %></select></div>
<div class="field"><label>شماره‌ی چینش (برای دریافت حالت دیگر تغییر دهید)</label><input type="number" class="ltr" name="seed" min="1" value="<%= f.seed || 1 %>"></div></div>
<div class="form-actions"><button class="btn primary"><%- icon('eye', 16) %> پیش‌نمایش</button></div></form>
<% if (result) { %><div class="card"><h3>نتیجه‌ی پیش‌نمایش</h3>
<p><b><%= fa(result.placed) %></b> از <b><%= fa(result.total) %></b> ساعت چیده شد. <% if (result.existing) { %><span class="muted">(<%= fa(result.existing) %> ساعت ثابت از کلاس‌های دیگر لحاظ شد)</span><% } %></p>
<% if (result.unplaced.length) { %><div class="alert warn"><%- icon('triangle-alert', 18) %><div><b>این ساعت‌ها جا نشدند</b> (ظرفیت زنگ‌ها یا ساعت‌های آزاد معلم کافی نیست):<ul><% result.unplaced.forEach(function(u){ %><li><%= u.cls %> — <%= u.subject %> <%= u.teacher ? '(' + u.teacher + ')' : '' %>: <%= fa(u.n) %> ساعت</li><% }) %></ul></div></div><% } else { %><div class="alert success"><%- icon('circle-check', 18) %><div>همه‌ی ساعت‌ها بدون تداخل چیده شد.</div></div><% } %>
<form method="post" action="<%= u('/timetable/auto') %>" data-confirm="برنامه‌ی فعلی جایگزین شود؟"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="phase" value="apply"><input type="hidden" name="scope" value="<%= f.scope %>"><input type="hidden" name="class_id" value="<%= f.class_id || '' %>"><input type="hidden" name="seed" value="<%= result.seed %>">
<button class="btn primary"><%- icon('save', 16) %> ذخیره و جایگزینی برنامه</button></form></div><% } %>
