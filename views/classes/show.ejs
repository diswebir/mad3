<div class="page-head"><div><div class="crumbs"><a href="<%= u('/classes') %>">کلاس‌ها</a></div><h1><%= c.name %> <span class="badge blue"><%= c.grade_level || '' %></span></h1>
<div class="muted">معلم راهنما: <b><%= c.homeroom_name || 'تعیین نشده' %></b> <% if (c.homeroom_phone) { %>(<span class="ltr"><%= fa(c.homeroom_phone) %></span>)<% } %> — اتاق <%= fa(c.room_no || '—') %> — سال <%= fa(c.year_title || '—') %></div></div>
<div class="actions">
<% if (enabled('attendance')) { %><a class="btn" href="<%= u('/attendance?class_id=' + c.id) %>"><%- icon('calendar-check', 16) %> حضور و غیاب</a><% } %>
<% if (enabled('timetable')) { %><a class="btn" href="<%= u('/timetable?class_id=' + c.id) %>"><%- icon('clock', 16) %> برنامه هفتگی</a><% } %>
<% if (enabled('grades')) { %><a class="btn" href="<%= u('/grades/class/' + c.id) %>"><%- icon('award', 16) %> کارنامه کلاس</a><% } %>
<a class="btn" href="<%= u('/classes/' + c.id + '/print') %>"><%- icon('printer', 16) %> چاپ لیست</a>
<% if (mgrFlag) { %><a class="btn primary" href="<%= u('/classes/' + c.id + '/edit') %>"><%- icon('pencil', 16) %> ویرایش</a><% } %></div></div>
<div class="grid g4" style="margin-bottom:1rem">
  <div class="card stat" style="margin:0"><div class="ico"><%- icon('graduation-cap', 22) %></div><div><div class="v"><%= fa(students.filter(function(s){ return s.status === 'active'; }).length) %> / <%= fa(c.capacity) %></div><div class="l">دانش‌آموز / ظرفیت</div></div></div>
  <div class="card stat green" style="margin:0"><div class="ico"><%- icon('book-open', 22) %></div><div><div class="v"><%= fa(subjects.length) %></div><div class="l">درس</div></div></div>
  <% if (typeof attRate !== 'undefined') { %><div class="card stat amber" style="margin:0"><div class="ico"><%- icon('calendar-check', 22) %></div><div><div class="v"><%= attRate === null ? '—' : fa(attRate) + '٪' %></div><div class="l">درصد حضور</div></div></div><% } %>
  <% if (typeof avg !== 'undefined') { %><div class="card stat" style="margin:0"><div class="ico"><%- icon('award', 22) %></div><div><div class="v"><%= avg === null ? '—' : fa(avg) %></div><div class="l">میانگین کلاس</div></div></div><% } %>
</div>
<div class="grid g-side"><div>
<div class="card flush"><div class="card-title"><%- icon('book-open', 18) %> دروس و معلمان کلاس</div>
<% if (!subjects.length) { %><div class="empty">درسی به این کلاس اضافه نشده است.</div><% } else { %><div class="table-wrap"><table class="t"><thead><tr><th>درس</th><th>معلم</th><th>ساعت هفتگی / حداکثر در روز</th><% if (mgrFlag) { %><th></th><% } %></tr></thead><tbody>
<% subjects.forEach(function(s){ %><tr><td><b><%= s.subject_name %></b></td>
<% if (mgrFlag) { %><td colspan="2"><form method="post" action="<%= u('/classes/' + c.id + '/subjects/' + s.id + '/update') %>" style="display:flex;gap:.4rem;align-items:center"><input type="hidden" name="_csrf" value="<%= csrf %>"><select name="teacher_id"><option value="">— بدون معلم —</option><% teachers.forEach(function(t){ %><option value="<%= t.id %>" <%= t.id === s.teacher_id ? 'selected' : '' %>><%= t.full_name %></option><% }) %></select><input type="text" class="digits ltr" name="weekly_hours" value="<%= s.weekly_hours %>" style="width:60px"><input type="text" class="digits ltr" name="max_per_day" value="<%= s.max_per_day || 2 %>" style="width:52px" title="حداکثر ساعت این درس در یک روز" aria-label="حداکثر در روز"><button class="btn sm">ذخیره</button></form></td>
<td class="actions"><form method="post" action="<%= u('/classes/' + c.id + '/subjects/' + s.id + '/delete') %>" data-confirm="درس از کلاس حذف شود؟"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm ghost" style="color:var(--red)"><%- icon('trash-2', 15) %></button></form></td>
<% } else { %><td><%= s.teacher_name || '—' %></td><td><%= fa(s.weekly_hours) %></td><% } %></tr><% }) %></tbody></table></div><% } %>
<% if (mgrFlag && availableSubjects.length) { %><form method="post" action="<%= u('/classes/' + c.id + '/subjects') %>" class="toolbar" style="border-top:1px solid var(--border);border-bottom:0"><input type="hidden" name="_csrf" value="<%= csrf %>"><b class="small">افزودن درس:</b>
<select name="subject_id" required><option value="">درس...</option><% availableSubjects.forEach(function(s){ %><option value="<%= s.id %>"><%= s.name %></option><% }) %></select><select name="teacher_id"><option value="">معلم...</option><% teachers.forEach(function(t){ %><option value="<%= t.id %>"><%= t.full_name %></option><% }) %></select><input type="text" class="ltr digits" name="weekly_hours" placeholder="ساعت" style="width:70px"><button class="btn primary sm"><%- icon('plus', 15) %> افزودن</button></form><% } %></div>
<div class="card flush"><div class="card-title"><%- icon('graduation-cap', 18) %> دانش‌آموزان کلاس (<%= fa(students.length) %>)</div>
<% if (!students.length) { %><div class="empty">دانش‌آموزی در این کلاس نیست.</div><% } else { %><div class="table-wrap"><table class="t"><thead><tr><th>#</th><th>نام</th><th>شماره</th><th>تماس اولیا</th><th>وضعیت</th><% if (mgrFlag) { %><th></th><% } %></tr></thead><tbody>
<% students.forEach(function(s, i){ %><tr><td><%= fa(i + 1) %></td><td><a href="<%= u('/students/' + s.id) %>"><%= s.first_name %> <%= s.last_name %></a></td><td class="num"><%= fa(s.student_code) %></td><td class="ltr num small"><%= fa(s.father_phone || s.mother_phone || '—') %></td><td><%- pill(L.studentStatus[s.status], badges_map.studentStatus[s.status]) %></td>
<% if (mgrFlag) { %><td class="actions"><form method="post" action="<%= u('/classes/' + c.id + '/remove-student/' + s.id) %>" data-confirm="دانش‌آموز از کلاس خارج شود؟"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm ghost" title="خروج از کلاس"><%- icon('x', 15) %></button></form></td><% } %></tr><% }) %></tbody></table></div><% } %></div>
</div><div>
<% if (typeof topStudents !== 'undefined' && topStudents.length) { %><div class="card"><h3><%- icon('trophy', 18) %> دانش‌آموزان برتر</h3><ul class="list"><% topStudents.forEach(function(s, i){ %><li><span class="badge amber"><%= fa(i + 1) %></span><div class="grow"><a href="<%= u('/students/' + s.id) %>"><%= s.first_name %> <%= s.last_name %></a></div><b class="num"><%= fa(s.overall) %></b></li><% }) %></ul></div><% } %>
<% if (mgrFlag) { %><div class="card"><h3><%- icon('user-plus', 18) %> افزودن دانش‌آموز بدون کلاس</h3>
<% if (!unassigned.length) { %><div class="muted small">دانش‌آموز بدون کلاس وجود ندارد.</div><% } else { %><form method="post" action="<%= u('/classes/' + c.id + '/add-students') %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><div style="max-height:220px;overflow:auto;border:1px solid var(--border);border-radius:9px;padding:.4rem"><% unassigned.forEach(function(s){ %><label class="check" style="padding:.15rem"><input type="checkbox" name="ids" value="<%= s.id %>"> <%= s.first_name %> <%= s.last_name %></label><% }) %></div><button class="btn primary sm" style="margin-top:.6rem">افزودن انتخاب‌شده‌ها</button></form><% } %></div>
<form method="post" action="<%= u('/classes/' + c.id + '/delete') %>" data-confirm="کلاس حذف شود؟"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn danger block"><%- icon('trash-2', 16) %> حذف کلاس</button></form><% } %>
</div></div>
