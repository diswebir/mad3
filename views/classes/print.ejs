<div class="page-head no-print"><h1>لیست کلاس</h1><div class="actions"><button class="btn primary" data-print><%- icon('printer', 16) %> چاپ</button><a class="btn" href="<%= u('/classes/' + c.id) %>">بازگشت</a></div></div>
<div class="card"><div style="text-align:center;margin-bottom:1rem"><h2 style="margin:0"><%= S('school_name') %></h2><div>لیست دانش‌آموزان کلاس <b><%= c.name %></b> — معلم راهنما: <%= c.homeroom_name || '—' %> — <%= ld(J.todayISO()) %></div></div>
<table class="t"><thead><tr><th>ردیف</th><th>نام و نام خانوادگی</th><th>شماره دانش‌آموزی</th><th>نام پدر</th><th>تماس اولیا</th><th style="width:140px">توضیحات</th></tr></thead><tbody><% students.forEach(function(s, i){ %><tr><td><%= fa(i + 1) %></td><td><%= s.first_name %> <%= s.last_name %></td><td><%= fa(s.student_code) %></td><td><%= s.father_name || '' %></td><td class="ltr"><%= fa(s.father_phone || s.mother_phone || '') %></td><td></td></tr><% }) %></tbody></table></div>
