<div class="page-head"><div><h1><%- icon('life-buoy', 24) %> تیکت‌ها</h1><div class="muted small"><%= fa(total) %> تیکت</div></div><div class="actions"><a class="btn primary" href="<%= u('/tickets/new') %>"><%- icon('plus', 16) %> تیکت جدید</a></div></div>
<div class="tabs"><a class="<%= !f.view ? 'active' : '' %>" href="<%= u('/tickets') %>">همه</a><a class="<%= f.view === 'todo' ? 'active' : '' %>" href="<%= u('/tickets?view=todo') %>">منتظر اقدام من<% if (badgeCounts && badgeCounts.tickets) { %> <span class="badge red"><%= fa(badgeCounts.tickets) %></span><% } %></a><a class="<%= f.view === 'mine' ? 'active' : '' %>" href="<%= u('/tickets?view=mine') %>">ارسالی من</a></div>
<div class="card flush">
<form class="toolbar" method="get"><input type="hidden" name="view" value="<%= f.view || '' %>"><input type="text" name="q" value="<%= f.q || '' %>" placeholder="جستجوی موضوع یا ارسال‌کننده" style="min-width:220px">
<select name="status" data-autosubmit><option value="">همه وضعیت‌ها</option><% Object.keys(L.ticketStatus).forEach(function(k){ %><option value="<%= k %>" <%= f.status === k ? 'selected' : '' %>><%= L.ticketStatus[k] %></option><% }) %></select>
<select name="category" data-autosubmit><option value="">همه دسته‌ها</option><% Object.keys(L.ticketCategory).forEach(function(k){ %><option value="<%= k %>" <%= f.category === k ? 'selected' : '' %>><%= L.ticketCategory[k] %></option><% }) %></select>
<select name="priority" data-autosubmit><option value="">همه اولویت‌ها</option><% Object.keys(L.priority).forEach(function(k){ %><option value="<%= k %>" <%= f.priority === k ? 'selected' : '' %>><%= L.priority[k] %></option><% }) %></select>
<button class="btn"><%- icon('search', 15) %> جستجو</button></form>
<% if (!rows.length) { %><div class="empty"><%- icon('life-buoy', 42) %><div>تیکتی یافت نشد.</div></div><% } else { %>
<div class="table-wrap"><table class="t"><thead><tr><th>#</th><th>موضوع</th><th>از</th><th>به</th><th>دسته</th><th>اولویت</th><th>وضعیت</th><th>آخرین بروزرسانی</th></tr></thead><tbody>
<% rows.forEach(function(t){ %><tr><td class="num muted"><%= fa(t.id) %></td><td><a href="<%= u('/tickets/' + t.id) %>"><b><%= t.subject %></b></a> <span class="muted small">(<%= fa(t.msg_count) %> پیام)</span></td><td><%= t.created_by === uid ? 'من' : t.creator_name %></td><td><%= t.recipient_name || 'مدیریت' %></td><td><%= L.ticketCategory[t.category] %></td><td><%- pill(L.priority[t.priority], badges_map.priority[t.priority]) %></td><td><%- pill(L.ticketStatus[t.status], badges_map.ticketStatus[t.status]) %></td><td class="muted small nowrap"><%= dt(t.updated_at || t.created_at) %></td></tr><% }) %></tbody></table></div>
<%- include('../partials/pager', { page: page, pages: pages }) %><% } %></div>
