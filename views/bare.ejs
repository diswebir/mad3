<!doctype html>
<html lang="fa" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title ? title + ' | ' : '' %><%= typeof S === 'function' && S('school_name') ? S('school_name') : 'سامانه مدیریت مدرسه' %></title>
<link rel="preload" href="<%= base %>/assets/fonts/Vazirmatn-Variable.woff2" as="font" type="font/woff2" crossorigin>
<link rel="icon" type="image/svg+xml" href="<%= base %>/assets/favicon.svg">
<link rel="stylesheet" href="<%= asset('css/app.css') %>">
<% if (typeof S === 'function' && /^#[0-9a-fA-F]{6}$/.test(S('primary_color') || '')) { %><style>:root{--primary:<%= S('primary_color') %>}</style><% } %>
<% if (typeof extraCss !== 'undefined' && extraCss) { %><link rel="stylesheet" href="<%= asset(extraCss) %>"><% } %>
<link rel="manifest" href="<%= base %>/manifest.webmanifest">
<link rel="apple-touch-icon" href="<%= base %>/assets/icons/apple-touch-icon.png">
<meta name="mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-title" content="<%= typeof S === 'function' ? S('school_name') : '' %>">
<script src="<%= asset('js/theme.js') %>"></script>
<script src="<%= asset('js/pwa.js') %>" data-base="<%= base %>" defer></script>
</head>
<body>
<%- body %>
<script src="<%= asset('js/jalaali.js') %>" defer></script>
<script src="<%= asset('js/app.js') %>" defer></script>
<% if (typeof extraJs !== 'undefined' && extraJs) { %><script src="<%= asset(extraJs) %>" defer></script><% } %>
</body>
</html>
