<div class="page-head"><div><div class="crumbs"><a href="<%= u('/library/books') %>">کتابخانه</a></div><h1><%- icon('book-marked', 24) %> امانت کتاب</h1></div><div class="actions"><a class="btn" href="<%= u('/library/books') %>"><%- icon('library-big', 16) %> فهرست کتاب‌ها</a></div></div>
<% if (isManager) { %><form class="card" method="post" action="<%= u('/library/loans') %>" autocomplete="off"><input type="hidden" name="_csrf" value="<%= csrf %>"><h3><%- icon('plus', 18) %> ثبت امانت جدید</h3>
<div class="form-grid c3"><div class="field"><label>کتاب</label><select name="book_id" required><option value="">— انتخاب —</option><% books.forEach(function(b){ %><option value="<%= b.id %>"><%= b.title %> (موجود: <%= fa(b.copies - b.lent) %>)</option><% }) %></select></div>
<div class="field"><label>امانت‌گیرنده</label><select name="borrower" required><option value="">— انتخاب —</option><optgroup label="دانش‌آموزان"><% students.forEach(function(s){ %><option value="s:<%= s.id %>"><%= s.last_name %> <%= s.first_name %> — <%= s.cname || '' %></option><% }) %></optgroup><optgroup label="معلمان"><% teachers.forEach(function(t){ %><option value="t:<%= t.id %>"><%= t.full_name %></option><% }) %></optgroup></select></div>
<div class="field"><label>موعد بازگشت</label><input class="jdate ltr" type="text" name="due_date" value="<%= defaultDue %>" autocomplete="off"></div></div>
<button class="btn primary" style="margin-top:.8rem">ثبت امانت</button></form><% } %>
<div class="tabs"><% [['active', 'در امانت'], ['overdue', 'دیرکرد'], ['returned', 'بازگردانده‌شده'], ['all', 'همه']].forEach(function(t){ %><a class="<%= view === t[0] ? 'active' : '' %>" href="?view=<%= t[0] %>"><%= t[1] %></a><% }) %></div>
<div class="card flush"><% if (!rows.length) { %><div class="empty">موردی یافت نشد.</div><% } else { %><div class="table-wrap"><table class="t"><thead><tr><th>کتاب</th><th>امانت‌گیرنده</th><th>تاریخ امانت</th><th>موعد</th><th>وضعیت</th><% if (isManager) { %><th></th><% } %></tr></thead><tbody>
<% rows.forEach(function(r){ var over = !r.returned_at && r.due_date < today; %><tr><td><b><%= r.title %></b></td><td><%= r.first_name ? r.first_name + ' ' + r.last_name + (r.class_name ? ' (' + r.class_name + ')' : '') : r.teacher_name %></td><td><%= d(r.loan_date) %></td><td><%= d(r.due_date) %></td><td><%- r.returned_at ? pill('بازگردانده شد ' + d(r.returned_at), 'green') : (over ? pill('دیرکرد', 'red') : pill('در امانت', 'blue')) %></td>
<% if (isManager) { %><td class="actions"><% if (!r.returned_at) { %><form method="post" action="<%= u('/library/loans/' + r.id + '/return') %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm"><%- icon('rotate-ccw', 15) %> ثبت بازگشت</button></form><% } %></td><% } %></tr><% }) %></tbody></table></div><% } %></div>

<% if (typeof pages !== 'undefined') { %><%- include('../partials/pager', { page: page, pages: pages }) %><% } %>
