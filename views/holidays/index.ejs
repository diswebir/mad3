<div class="page-head"><div><h1><%- icon('calendar-off', 24) %> تعطیلات و تقویم آموزشی</h1><div class="muted">روزهای تعطیل در حضور و غیاب، برنامه‌ی هفتگی، امتحانات و گزارش‌ها به‌عنوان «روز غیرتحصیلی» حساب می‌شوند. جمعه‌ها و روزهای خارج از هفته‌ی مدرسه خودکار تعطیل‌اند.</div></div>
<div class="actions"><a class="btn" href="<%= u('/holidays?year=' + (jy - 1)) %>"><%- icon('chevron-right', 16) %> <%= fa(jy - 1) %></a><span class="btn ghost"><%= fa(jy) %></span><a class="btn" href="<%= u('/holidays?year=' + (jy + 1)) %>"><%= fa(jy + 1) %> <%- icon('chevron-left', 16) %></a><a class="btn" href="<%= u('/calendar') %>"><%- icon('calendar-days', 16) %> تقویم</a></div></div>
<div class="grid g2">
<form class="card" method="post" action="<%= u('/holidays') %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="card-title"><%- icon('plus', 18) %> ثبت تعطیلی دستی</div>
<div class="field"><label>عنوان</label><input type="text" name="title" required maxlength="150" placeholder="مثلاً: تاسوعا و عاشورا / تعطیلی به‌دلیل آلودگی هوا"></div>
<div class="grid g2"><div class="field"><label>از تاریخ</label><input type="text" name="start_date" class="ltr jdate" required autocomplete="off"></div><div class="field"><label>تا تاریخ (اختیاری)</label><input type="text" name="end_date" class="ltr jdate" autocomplete="off"><div class="hint">خالی = فقط یک روز</div></div></div>
<div class="form-actions"><button class="btn primary"><%- icon('save', 16) %> ثبت تعطیلی</button></div></form>
<form class="card" method="post" action="<%= u('/holidays/fixed') %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="year" value="<%= jy %>"><div class="card-title"><%- icon('wand-sparkles', 18) %> تعطیلات رسمی ثابت سال <%= fa(jy) %></div>
<ul class="muted small" style="columns:2;margin:.2rem 0 .8rem;padding-inline-start:1.2rem"><% fixed.forEach(function(f){ %><li><%= fa(f[1]) %> <%= MONTHS[f[0] - 1] %>: <%= f[2] %></li><% }) %></ul>
<div class="muted small">فقط تعطیلات با تاریخ ثابت شمسی. مناسبت‌های قمری هر سال جابه‌جا می‌شوند و باید دستی ثبت شوند.</div>
<div class="form-actions"><button class="btn"><%- icon('calendar-plus', 16) %> افزودن به تقویم</button></div></form></div>
<div class="card flush"><div class="card-title" style="padding:.8rem 1rem">تعطیلی‌های سال <%= fa(jy) %> <span class="badge"><%= fa(list.length + events.length) %></span></div>
<% if (!list.length && !events.length) { %><div class="empty" style="padding:1.5rem">تعطیلی‌ای ثبت نشده است.</div><% } else { %><div class="table-wrap"><table class="t"><thead><tr><th>عنوان</th><th>از</th><th>تا</th><th>نوع</th><th></th></tr></thead><tbody>
<% list.forEach(function(h){ %><tr><td><form method="post" action="<%= u('/holidays/' + h.id + '/update') %>" class="inline-edit"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="text" name="title" value="<%= h.title %>" maxlength="150" required></td><td><input type="text" name="start_date" class="ltr jdate" value="<%= J.isoToJString(h.start_date) %>" autocomplete="off" style="width:120px"></td><td><input type="text" name="end_date" class="ltr jdate" value="<%= J.isoToJString(h.end_date) %>" autocomplete="off" style="width:120px"></td><td><span class="badge <%= h.kind === 'official' ? 'blue' : 'amber' %>"><%= h.kind === 'official' ? 'رسمی' : 'دستی' %></span></td>
<td><button class="btn sm"><%- icon('save', 14) %></button></form> <form method="post" action="<%= u('/holidays/' + h.id + '/delete') %>" style="display:inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm danger" data-confirm="این تعطیلی حذف شود؟"><%- icon('trash-2', 14) %></button></form></td></tr><% }) %>
<% events.forEach(function(e){ %><tr><td><%= e.title %></td><td><%= d(e.start_date) %></td><td><%= d(e.end_date || e.start_date) %></td><td><span class="badge">رویداد</span></td><td><a class="btn sm" href="<%= u('/events') %>">مدیریت رویدادها</a></td></tr><% }) %>
</tbody></table></div><% } %></div>
